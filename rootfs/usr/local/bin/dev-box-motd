#!/usr/bin/env bash
# devbox:name=motd
# devbox:summary=The login line: one command to try, pending updates, DEV_ENVS
# devbox:summary.fr=La ligne d'accueil : une commande à essayer, les mises à jour, DEV_ENVS
# devbox:args=
# What you see when you land in the box: one line with a command of the box
# drawn at random and what it does, one more when an update is waiting, and
# one when the DEV_ENVS environments of .env are still installing or failed.
# The first time after an update, the notes of the new release come first.
# Interactive shells print it through /etc/devbox/updates-motd.sh, once per
# tmux session.
#
#   dev-box-motd   print it again
#
# It reads nothing but the box and its cache: no network, a few milliseconds.
set -euo pipefail

UPDATES="$HOME/.cache/dev-box/updates"
# Written by the entrypoint while DEV_ENVS is being installed, or when it failed
DEV_ENVS_FLAG="$HOME/.cache/dev-box/dev-envs"
# The release notes kept by devbox check, and the version of the image whose
# notes were last shown
RELEASES="$HOME/.cache/dev-box/releases.md"
CHANGELOG_SEEN="$HOME/.config/dev-box/changelog-seen"

usage() { sed -n '6,14p' "$0" | sed 's/^# \?//'; }
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") ;;
  *) echo "dev-box-motd: unknown option '$1'" >&2; usage >&2; exit 2 ;;
esac

# Colors written out rather than read from tput: this is on the critical path
# of every login, and every fork there is one too many.
C_OFF=""; C_CMD=""; C_DIM=""; C_WARN=""
if [ -t 1 ] && [ -n "${TERM:-}" ] && [ "${TERM}" != "dumb" ]; then
  C_OFF=$'\033[0m'; C_CMD=$'\033[1;36m'; C_DIM=$'\033[2m'; C_WARN=$'\033[33m'
fi

# TS_DISABLE is not in the environment of an SSH session: the entrypoint writes
# it to /etc/devbox/env. Read, not sourced, like the devbox dispatcher does.
tailscale_off() {
  local ts="${TS_DISABLE:-}"
  if [ -z "$ts" ] && [ -r /etc/devbox/env ]; then
    ts="$(sed -n 's/^export TS_DISABLE=//p' /etc/devbox/env | tail -n 1)"
  fi
  [ "${ts:-false}" = "true" ]
}

# The commands on offer, "command|what it does", one per line. The ones that
# need Tailscale carry a third field and are left out when it is off. Adding
# one is adding a line here, and its translation to
# /usr/share/devbox/motd/tips.fr (a tip missing there is shown in English).
TIPS=(
  'devbox|the menu of everything the box can do'
  'devbox status|the state of the box on one page'
  'devbox tour|a guided tour of the box, two minutes'
  'devbox update|update the dotfiles, the tools and the shipped config'
  'devbox update tools|upgrade the mise tools only'
  'devbox update dotfiles|pull the dotfiles again'
  'devbox agent|run the default coding agent'
  'devbox agent set|pick the default coding agent'
  'devbox agent usage|account limits and tokens per model'
  'devbox agent prompt "review this"|the default agent, told what to do'
  'devbox dev-env|pick language toolchains, through mise'
  'devbox dev-env node go|install these toolchains right away'
  'devbox dbs postgres redis|start these databases, data kept in a volume'
  'devbox dbs --list|the databases, their port and their state'
  'devbox pkg add htop|a pacman package that survives a rebuild'
  'devbox pkg install|fuzzy picker over the Arch repositories'
  'devbox mise-install crush|a mise-backed wrapper in ~/.local/bin'
  'devbox seed --check|new shipped config, nothing written'
  'devbox override|what this box changes from the image'
  'devbox diagnostic|your coding agent looks for what is broken, asks before fixing'
  'devbox diagnostic --report|the facts about this box, to paste to someone'
  'devbox migrate --list|the migrations of this image, played or pending'
  'devbox check|look for updates, install nothing'
  'devbox changelog|what changed in the box, newest first'
  'devbox serve 3000|publish port 3000 of the box on the tailnet|tailscale'
  'devbox serve 8080:3000|tailnet port 8080, app on 3000|tailscale'
  'devbox tailscale send laptop file.tar|Taildrop a file to another machine|tailscale'
  'devbox tailscale receive|wait for Taildrop files into ~/inbox|tailscale'
  'NO_TMUX=1 ssh dev@box|a shell without the tmux session'
)

# The tips are the one thing of the motd that is translated: the language of
# the locale (LANG in .env, see /usr/share/devbox/lib/lang.sh) picks
# /usr/share/devbox/motd/tips.<lang>, "command|what it does" lines keyed by
# the command of TIPS.
DEVBOX_LANG=""
if [ -r /usr/share/devbox/lib/lang.sh ]; then
  . /usr/share/devbox/lib/lang.sh
  devbox_lang
fi

# tip_text <command> <English text>: sets TIP_TEXT to the text in the
# language of the box when tips.<lang> has it, the English one otherwise.
# Read in bash, no fork.
tip_text() {
  local file="/usr/share/devbox/motd/tips.$DEVBOX_LANG" line
  TIP_TEXT="$2"
  [ -n "$DEVBOX_LANG" ] && [ -r "$file" ] || return 0
  while IFS= read -r line; do
    case "$line" in
      "$1|"*) TIP_TEXT="${line#"$1|"}"; return 0 ;;
    esac
  done < "$file"
}

# One line: the command, then what it does. shuf draws it, as every motd of
# this kind does.
tip_line() {
  local off=no t
  tailscale_off && off=yes
  t="$(for t in "${TIPS[@]}"; do
         case "$t" in
           *'|tailscale') [ "$off" = "yes" ] && continue; t="${t%|tailscale}" ;;
         esac
         printf '%s\n' "$t"
       done | shuf -n 1)"
  [ -n "$t" ] || return 0
  tip_text "${t%%|*}" "${t#*|}"
  printf '%sTips:%s %s%s%s  %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CMD" "${t%%|*}" "$C_OFF" \
    "$C_DIM" "$TIP_TEXT" "$C_OFF"
}

# The detail of what is waiting stays in `devbox check` and `devbox status`:
# here one line is enough to say there is something to read.
updates_line() {
  local n
  [ -s "$UPDATES" ] || return 0
  n="$(grep -c '' "$UPDATES" 2>/dev/null || true)"
  [ -n "$n" ] && [ "$n" -gt 0 ] || return 0
  if [ "$n" -eq 1 ]; then
    printf '%s1 update available, run devbox update%s\n' "$C_WARN" "$C_OFF"
  else
    printf '%s%s updates available, run devbox update%s\n' "$C_WARN" "$n" "$C_OFF"
  fi
}

# The one update line that cannot wait for devbox status: this arm64 box
# follows an image that is not the arm64 one, and the next pull on the host
# would bring the amd64 image. Written in full by dev-box-check-updates, with
# the DEVBOX_IMAGE line to put in .env. Read in bash, no fork.
image_arch_line() {
  local line
  [ -s "$UPDATES" ] || return 0
  while IFS= read -r line; do
    case "$line" in
      "dev-box image: "*"DEVBOX_IMAGE="*) printf '%s%s%s\n' "$C_WARN" "$line" "$C_OFF" ;;
    esac
  done < "$UPDATES"
}

# DEV_ENVS at start: one line while it installs, one when it failed. The
# entrypoint removes the flag once everything is there.
dev_envs_line() {
  [ -s "$DEV_ENVS_FLAG" ] || return 0
  printf '%s%s%s\n' "$C_WARN" "$(head -n 1 "$DEV_ENVS_FLAG")" "$C_OFF"
}

# The release notes, once after an update. The comparison stays in bash, so a
# login with nothing new costs no fork; dev-box-changelog prints the notes
# not seen yet and records this image as seen.
changelog_block() {
  local line version="" seen=""
  [ -r "$RELEASES" ] && [ -r /etc/devbox/release ] || return 0
  while IFS= read -r line; do
    case "$line" in DEVBOX_VERSION=*) version="${line#DEVBOX_VERSION=}"; break ;; esac
  done < /etc/devbox/release
  [ -n "$version" ] || return 0
  [ -r "$CHANGELOG_SEEN" ] && IFS= read -r seen < "$CHANGELOG_SEEN" || true
  [ "$seen" != "$version" ] || return 0
  command -v dev-box-changelog >/dev/null 2>&1 || return 0
  dev-box-changelog --new || true
}

printf '\n'
changelog_block
tip_line
updates_line
image_arch_line
dev_envs_line
printf '\n'
