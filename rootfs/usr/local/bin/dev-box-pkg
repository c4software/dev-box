#!/usr/bin/env bash
# devbox:name=pkg
# devbox:summary=Persistent pacman packages (reinstalled at start)
# devbox:args=[add|drop|list|install|restore]
# pacman packages that survive an image rebuild. pacman installs into the
# image, and the image is disposable, so the list of packages added by hand is
# kept in the home (~/.config/dev-box/packages) and reinstalled at start when
# the image started over from scratch.
#
#   dev-box-pkg add <packages...>   install, and remember
#   dev-box-pkg drop <packages...>  uninstall, and forget
#   dev-box-pkg list                the list, with the state of each one
#   dev-box-pkg install             fuzzy picker (fzf) over the Arch repositories
#   dev-box-pkg restore             reinstall what is missing from the list
#   dev-box-pkg                     menu: one of the above, gum asks the names
#
# Only packages come back: a config edited by hand in /etc disappears on the
# rebuild with nothing to catch it. The durable answer stays the Dockerfile.
set -euo pipefail

LIST_DIR="$HOME/.config/dev-box"
LIST="$LIST_DIR/packages"

log() { echo "[dev-box-pkg] $*"; }
usage() { sed -n '5,18p' "$0" | sed 's/^# \?//'; }

installed() { pacman -Q "$1" >/dev/null 2>&1; }

# The pacman database of the image dates from the build: when it is too old for
# the mirrors, the download fails, so a -Sy brings it up to date and we try
# once more.
pac_install() {
  sudo pacman -S --needed --noconfirm "$@" && return 0
  log "refreshing the pacman database..."
  sudo pacman -Sy --noconfirm || return 1
  sudo pacman -S --needed --noconfirm "$@"
}

read_list() {
  [ -s "$LIST" ] || return 0
  grep -v '^[[:space:]]*$' "$LIST" | grep -v '^[[:space:]]*#' | sort -u
}

# Writes the list sorted and deduplicated, from standard input.
write_list() {
  mkdir -p "$LIST_DIR"
  sort -u > "$LIST.tmp"
  mv "$LIST.tmp" "$LIST"
}

add_to_list() {
  { read_list; printf '%s\n' "$@"; } | grep -v '^[[:space:]]*$' | write_list
}

remove_from_list() {
  local keep
  keep="$(read_list | grep -vxF -f <(printf '%s\n' "$@") || true)"
  printf '%s\n' "$keep" | grep -v '^[[:space:]]*$' | write_list || true
}

do_add() {
  [ $# -gt 0 ] || { echo "usage: devbox pkg add <packages...>" >&2; exit 2; }
  log "installing: $*"
  if ! pac_install "$@"; then
    log "⚠ pacman failed, nothing added to the list"
    exit 1
  fi
  # Second check: pacman does not always report an error through its exit code.
  local ok=() pkg
  for pkg in "$@"; do
    if installed "$pkg"; then
      ok+=("$pkg")
    else
      log "⚠ $pkg is not installed, it does not go into the list"
    fi
  done
  [ "${#ok[@]}" -gt 0 ] || exit 1
  add_to_list "${ok[@]}"
  log "${#ok[@]} package(s) kept in ~/.config/dev-box/packages"
}

do_drop() {
  [ $# -gt 0 ] || { echo "usage: devbox pkg drop <packages...>" >&2; exit 2; }
  local here=() pkg
  for pkg in "$@"; do
    installed "$pkg" && here+=("$pkg")
  done
  if [ "${#here[@]}" -gt 0 ]; then
    log "uninstalling: ${here[*]}"
    sudo pacman -Rs --noconfirm "${here[@]}" || { log "⚠ pacman failed"; exit 1; }
  else
    log "none of those packages is installed"
  fi
  remove_from_list "$@"
  log "list updated"
}

do_list() {
  local pkg count=0 missing=0
  while IFS= read -r pkg; do
    [ -n "$pkg" ] || continue
    count=$((count + 1))
    if installed "$pkg"; then
      printf '  %-28s installed\n' "$pkg"
    else
      printf '  %-28s missing\n' "$pkg"
      missing=$((missing + 1))
    fi
  done < <(read_list)
  if [ "$count" -eq 0 ]; then
    echo "  no persistent package (devbox pkg add <packages...>)"
    return 0
  fi
  echo
  log "$count package(s), $missing missing"
  [ "$missing" -gt 0 ] && log "devbox pkg restore to put them back"
  return 0
}

do_install() {
  command -v fzf >/dev/null 2>&1 || { echo "dev-box-pkg: fzf is missing" >&2; exit 1; }
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "dev-box-pkg: the picker needs a terminal." >&2
    echo "Give the names: devbox pkg add <packages...>" >&2
    exit 2
  fi
  local chosen sel=()
  chosen="$(pacman -Slq | fzf --multi \
      --preview 'pacman -Si {1}' \
      --preview-window 'down:60%:wrap' \
      --header 'tab: pick several, enter: install')" || true
  [ -n "$chosen" ] || { log "nothing selected"; exit 0; }
  mapfile -t sel <<< "$chosen"
  do_add "${sel[@]}"
}

do_restore() {
  local pkg missing=()
  while IFS= read -r pkg; do
    [ -n "$pkg" ] || continue
    installed "$pkg" || missing+=("$pkg")
  done < <(read_list)
  if [ "${#missing[@]}" -eq 0 ]; then
    log "nothing to reinstall, everything is in place"
    return 0
  fi
  log "reinstalling: ${missing[*]}"
  pac_install "${missing[@]}" || { log "⚠ pacman failed"; exit 1; }
  log "${#missing[@]} package(s) reinstalled"
}

# Without arguments, on a terminal: the subcommands as a gum menu, then the
# names are asked for. Without a terminal the usage is printed, as before.
menu() {
  local choice names=() chosen line
  choice="$(printf '%s\n' \
      "add       install packages by name, and remember them" \
      "install   fuzzy picker over the Arch repositories" \
      "drop      uninstall packages of the list, and forget them" \
      "list      the list, with the state of each one" \
      "restore   reinstall what is missing from the list" \
    | gum choose --height 7 --header "Persistent packages")" || exit 0
  [ -n "$choice" ] || exit 0
  case "${choice%% *}" in
    add)
      chosen="$(gum input --placeholder "packages, space separated (ripgrep-all htop)" \
                --header "Packages to install")" || exit 0
      read -ra names <<< "$chosen"
      [ "${#names[@]}" -gt 0 ] || { log "nothing given"; exit 0; }
      do_add "${names[@]}"
      ;;
    install) do_install ;;
    drop)
      mapfile -t names < <(read_list)
      [ "${#names[@]}" -gt 0 ] || { log "the list is empty, nothing to drop"; exit 0; }
      chosen="$(printf '%s\n' "${names[@]}" \
        | gum choose --no-limit --height 12 --header "Packages to drop (x to tick, enter to confirm)")" || exit 0
      [ -n "$chosen" ] || { log "nothing selected"; exit 0; }
      names=()
      while IFS= read -r line; do [ -n "$line" ] && names+=("$line"); done <<< "$chosen"
      do_drop "${names[@]}"
      ;;
    list)    do_list ;;
    restore) do_restore ;;
  esac
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  add)     do_add "$@" ;;
  drop)    do_drop "$@" ;;
  list)    do_list ;;
  install) do_install ;;
  restore) do_restore ;;
  -h|--help) usage ;;
  "")
    if [ -t 0 ] && [ -t 1 ] && command -v gum >/dev/null 2>&1; then
      menu
    else
      usage >&2; exit 2
    fi
    ;;
  *) echo "dev-box-pkg: unknown subcommand '$cmd'" >&2; usage >&2; exit 2 ;;
esac
