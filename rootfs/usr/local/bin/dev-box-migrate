#!/usr/bin/env bash
# devbox:name=migrate
# devbox:summary=Run the migrations shipped by the image, once each
# devbox:args=[--run|--pending|--list]
# Box migrations: small scripts shipped by the image that repair an existing
# home when a new image version changes something the seed cannot pick up on
# its own. Each migration runs once, in the order of its name, as your user,
# never as root.
#
#   dev-box-migrate                 run the pending migrations (on a terminal: a menu)
#   dev-box-migrate --run           run them, with no menu
#   dev-box-migrate --pending       list what is left, without doing anything
#   dev-box-migrate --list          every migration, with its state
#   dev-box-migrate --mark-done X   acknowledge a migration without running it
#   dev-box-migrate --mark-all-done acknowledge all of them (new home: nothing to repair)
#
# Log of the migrations already run: ~/.config/dev-box/migrations, one name
# per line. The first migration that fails stops the run: the ones behind it
# stay pending and are tried again on the next call.
set -euo pipefail

MIG_DIR="${DEVBOX_MIGRATIONS_DIR:-/usr/share/devbox/migrations}"
STATE_DIR="$HOME/.config/dev-box"
STATE="$STATE_DIR/migrations"

log() { echo "[dev-box-migrate] $*"; }

# The migrations write in the home: root would run them in the wrong place and
# leave behind files the user can no longer change.
if [ "$(id -u)" = "0" ]; then
  echo "dev-box-migrate: run it as your user, not as root" >&2
  exit 1
fi

# Names of the shipped migrations, sorted (the name starts with a timestamp).
all_names() {
  local f
  [ -d "$MIG_DIR" ] || return 0
  for f in "$MIG_DIR"/*.sh; do
    [ -f "$f" ] || continue
    basename "$f"
  done | sort
}

is_done() {
  [ -f "$STATE" ] || return 1
  grep -qxF "$1" "$STATE"
}

mark_done() {
  mkdir -p "$STATE_DIR"
  touch "$STATE"
  is_done "$1" || printf '%s\n' "$1" >> "$STATE"
}

pending_names() {
  local n
  while IFS= read -r n; do
    is_done "$n" || printf '%s\n' "$n"
  done < <(all_names)
}

usage() { sed -n '5,19p' "$0" | sed 's/^# \?//'; }

MODE="run"
EXPLICIT=false
MARK=""
while [ $# -gt 0 ]; do
  case "$1" in
    --run)           MODE="run"; EXPLICIT=true; shift ;;
    --pending)       MODE="pending"; shift ;;
    --list)          MODE="list"; shift ;;
    --mark-all-done) MODE="mark-all"; shift ;;
    --mark-done)
      MODE="mark"
      MARK="${2:-}"
      [ -n "$MARK" ] || { echo "dev-box-migrate: --mark-done expects a name" >&2; exit 2; }
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    *) echo "dev-box-migrate: unknown option '$1'" >&2; exit 2 ;;
  esac
done

# Without arguments, on a terminal: a gum menu. The entrypoint has no
# terminal, so it still runs what is pending, as before.
if [ "$MODE" = "run" ] && ! $EXPLICIT && [ $# -eq 0 ] \
   && [ -t 0 ] && [ -t 1 ] && command -v gum >/dev/null 2>&1; then
  n="$(pending_names | grep -c . || true)"
  choice="$(printf '%s\n' \
      "run       the pending migrations ($n)" \
      "pending   list what is left, without doing anything" \
      "list      every migration, with its state" \
      "mark      acknowledge a pending one without running it" \
    | gum choose --height 6 --header "Migrations of this image")" || exit 0
  [ -n "$choice" ] || exit 0
  MODE="${choice%% *}"
  if [ "$MODE" = "mark" ]; then
    [ "$n" -gt 0 ] || { log "nothing pending, nothing to acknowledge"; exit 0; }
    MARK="$(pending_names | gum choose --height 10 --header "Migration to acknowledge")" || exit 0
    [ -n "$MARK" ] || exit 0
  fi
fi

case "$MODE" in
  pending)
    pending_names
    exit 0
    ;;
  list)
    found=false
    while IFS= read -r name; do
      found=true
      if is_done "$name"; then
        printf '  %-40s played\n' "$name"
      else
        printf '  %-40s pending\n' "$name"
      fi
    done < <(all_names)
    $found || echo "  this image ships no migration"
    exit 0
    ;;
  mark)
    # The name works with or without .sh, and a full path is fine too.
    MARK="$(basename "$MARK")"
    [ "${MARK%.sh}" = "$MARK" ] && MARK="$MARK.sh"
    if ! all_names | grep -qxF "$MARK"; then
      echo "dev-box-migrate: '$MARK' is not a migration of this image" >&2
      exit 1
    fi
    mark_done "$MARK"
    log "migration acknowledged without being run: ${MARK%.sh}"
    exit 0
    ;;
  mark-all)
    count=0
    while IFS= read -r name; do
      is_done "$name" && continue
      mark_done "$name"
      count=$((count + 1))
    done < <(all_names)
    log "$count migration(s) acknowledged without being run"
    exit 0
    ;;
esac

# --- Run ---------------------------------------------------------------------
mapfile -t PENDING < <(pending_names)
if [ "${#PENDING[@]}" -eq 0 ]; then
  log "nothing to do, everything is up to date"
  exit 0
fi

log "${#PENDING[@]} migration(s) pending"
for name in "${PENDING[@]}"; do
  log "-> ${name%.sh}"
  if bash "$MIG_DIR/$name"; then
    mark_done "$name"
  else
    log "⚠ migration ${name%.sh} failed, stopping"
    log "  the ones behind it stay pending (devbox migrate to try again)"
    log "  to skip it: devbox migrate --mark-done $name"
    exit 1
  fi
done
log "done"
