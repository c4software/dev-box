#!/usr/bin/env bash
# devbox:name=migrate
# devbox:summary=Joue les migrations livrées par l'image, une fois chacune
# devbox:args=[--pending|--list]
# Migrations de la box : de petits scripts livrés par l'image qui réparent un
# home existant quand une nouvelle version change quelque chose que le seed ne
# sait pas reprendre tout seul. Chacune est jouée une seule fois, dans l'ordre
# de son nom, en tant qu'utilisateur.
#
#   dev-box-migrate                 joue les migrations en attente
#   dev-box-migrate --pending       liste ce qui reste à jouer, sans rien faire
#   dev-box-migrate --list          toutes les migrations, avec leur état
#   dev-box-migrate --mark-done X   acquitte une migration sans la jouer
#   dev-box-migrate --mark-all-done acquitte tout (home neuf : rien à réparer)
#
# Journal des migrations jouées : ~/.config/dev-box/migrations (un nom par
# ligne). La première migration qui échoue arrête tout : les suivantes restent
# en attente et seront rejouées au prochain appel.
set -euo pipefail

MIG_DIR="${DEVBOX_MIGRATIONS_DIR:-/usr/share/devbox/migrations}"
STATE_DIR="$HOME/.config/dev-box"
STATE="$STATE_DIR/migrations"

log() { echo "[dev-box-migrate] $*"; }

# Les migrations écrivent dans le home : root les jouerait au mauvais endroit
# et laisserait des fichiers que l'utilisateur ne peut plus modifier.
if [ "$(id -u)" = "0" ]; then
  echo "dev-box-migrate : à lancer en tant qu'utilisateur, pas en root" >&2
  exit 1
fi

# Noms des migrations livrées, triés (le nom commence par un horodatage).
all_names() {
  local f
  [ -d "$MIG_DIR" ] || return 0
  for f in "$MIG_DIR"/*.sh; do
    [ -f "$f" ] || continue
    basename "$f"
  done | sort
}

is_done() {
  [ -f "$STATE" ] || return 1
  grep -qxF "$1" "$STATE"
}

mark_done() {
  mkdir -p "$STATE_DIR"
  touch "$STATE"
  is_done "$1" || printf '%s\n' "$1" >> "$STATE"
}

pending_names() {
  local n
  while IFS= read -r n; do
    is_done "$n" || printf '%s\n' "$n"
  done < <(all_names)
}

usage() { sed -n '5,18p' "$0" | sed 's/^# \?//'; }

MODE="run"
MARK=""
while [ $# -gt 0 ]; do
  case "$1" in
    --pending)       MODE="pending"; shift ;;
    --list)          MODE="list"; shift ;;
    --mark-all-done) MODE="mark-all"; shift ;;
    --mark-done)
      MODE="mark"
      MARK="${2:-}"
      [ -n "$MARK" ] || { echo "dev-box-migrate : --mark-done attend un nom" >&2; exit 2; }
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    *) echo "dev-box-migrate : option inconnue « $1 »" >&2; exit 2 ;;
  esac
done

case "$MODE" in
  pending)
    pending_names
    exit 0
    ;;
  list)
    found=false
    while IFS= read -r name; do
      found=true
      if is_done "$name"; then
        printf '  %-40s jouée\n' "$name"
      else
        printf '  %-40s en attente\n' "$name"
      fi
    done < <(all_names)
    $found || echo "  aucune migration livrée par cette image"
    exit 0
    ;;
  mark)
    # Le nom peut être donné avec ou sans .sh, et un chemin complet passe aussi.
    MARK="$(basename "$MARK")"
    [ "${MARK%.sh}" = "$MARK" ] && MARK="$MARK.sh"
    if ! all_names | grep -qxF "$MARK"; then
      echo "dev-box-migrate : « $MARK » n'est pas une migration de cette image" >&2
      exit 1
    fi
    mark_done "$MARK"
    log "migration acquittée sans être jouée : ${MARK%.sh}"
    exit 0
    ;;
  mark-all)
    count=0
    while IFS= read -r name; do
      is_done "$name" && continue
      mark_done "$name"
      count=$((count + 1))
    done < <(all_names)
    log "$count migration(s) acquittée(s) sans être jouée(s)"
    exit 0
    ;;
esac

# --- Exécution ---------------------------------------------------------------
mapfile -t PENDING < <(pending_names)
if [ "${#PENDING[@]}" -eq 0 ]; then
  log "rien à faire, tout est à jour"
  exit 0
fi

log "${#PENDING[@]} migration(s) en attente"
for name in "${PENDING[@]}"; do
  log "→ ${name%.sh}"
  if bash "$MIG_DIR/$name"; then
    mark_done "$name"
  else
    log "⚠ la migration ${name%.sh} a échoué, arrêt"
    log "  les suivantes restent en attente (devbox migrate pour réessayer)"
    log "  pour passer outre : devbox migrate --mark-done $name"
    exit 1
  fi
done
log "terminé"
