#!/usr/bin/env bash
# devbox:name=agent
# devbox:summary=Default coding agent: run it, pick it, account usage
# devbox:summary.fr=Agent de code par défaut : le lancer, le choisir, voir sa consommation
# devbox:args=[set|prompt|which|usage]
# One default agent for the box, remembered in ~/.config/dev-box/agent, on the
# model of omarchy-default-agent and omarchy-agent.
#
#   dev-box-agent                  menu: run the default agent, pick one, usage
#   dev-box-agent set [name]       change the default agent (menu with no name)
#   dev-box-agent which            print the default agent
#   dev-box-agent prompt <text...> run the agent with an instruction
#   dev-box-agent usage [claude|codex|proxy]
#                                  account limits, one bar per window with the
#                                  percentage used and the time left before it
#                                  resets, then the tokens per model, each with
#                                  its share of the week and a sparkline, read
#                                  from the local transcripts. With no name:
#                                  the three of them, Claude Code, Codex and
#                                  the LLM proxy, read from its usage route.
#                                  The proxy block prints the cache hit rate of
#                                  each model next to its share bar, under a
#                                  header line naming the columns.
#
# The agents on offer are the ones shipped by the image (claude, pi, omp,
# opencode, codex) plus the wrappers written by `devbox mise-install`.
set -euo pipefail

CONF_DIR="$HOME/.config/dev-box"
CONF="$CONF_DIR/agent"
BUILTIN=(claude pi omp opencode codex)

usage() { sed -n '6,23p' "$0" | sed 's/^# \?//'; }

# Early, so that `devbox agent --help` really finds a help to print.
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

# Available agents: the ones from the image, plus the mise-install wrappers.
available() {
  local a f name
  for a in "${BUILTIN[@]}"; do printf '%s\n' "$a"; done
  if [ -d "$HOME/.local/bin" ]; then
    for f in "$HOME/.local/bin"/*; do
      [ -f "$f" ] || continue
      grep -qxF '# dev-box-mise-install' "$f" || continue
      name="$(basename "$f")"
      printf '%s\n' "$name"
    done
  fi
}
available_sorted() { available | sort -u; }

read_agent() {
  [ -s "$CONF" ] || return 1
  head -n 1 "$CONF" | tr -d '[:space:]'
}

write_agent() {
  mkdir -p "$CONF_DIR"
  printf '%s\n' "$1" > "$CONF"
  echo "[dev-box-agent] default agent: $1"
}

# The gum menu. Without a terminal we refuse rather than wait for nothing.
# The callers capture the result with $(...), so stdout is never a terminal
# here: the test looks at stdin and stderr, which gum draws on.
choose_agent() {
  local chosen
  if [ ! -t 0 ] || [ ! -t 2 ]; then
    echo "dev-box-agent: no terminal for the menu." >&2
    echo "Give a name: devbox agent set <name>" >&2
    echo "On offer: $(available_sorted | tr '\n' ' ')" >&2
    return 1
  fi
  command -v gum >/dev/null 2>&1 || {
    echo "dev-box-agent: gum is missing, give a name: devbox agent set <name>" >&2
    return 1
  }
  chosen="$(available_sorted | gum choose --height 10 --header "Default coding agent")" || true
  [ -n "$chosen" ] || return 1
  printf '%s' "$chosen"
}

set_agent() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    name="$(choose_agent)" || exit 1
  fi
  if ! available_sorted | grep -qxF "$name"; then
    echo "dev-box-agent: '$name' is not an agent this box knows" >&2
    echo "On offer: $(available_sorted | tr '\n' ' ')" >&2
    echo "Another tool: devbox mise-install <package> <name>" >&2
    exit 1
  fi
  write_agent "$name"
}

# The default agent, asking for one when none has been picked yet.
current_agent() {
  local name
  if name="$(read_agent)" && [ -n "$name" ]; then
    printf '%s' "$name"
    return 0
  fi
  name="$(choose_agent)" || return 1
  write_agent "$name" >&2
  printf '%s' "$name"
}

# How each agent takes an instruction on its command line.
run_with_prompt() {
  local agent="$1" prompt="$2"
  case "$agent" in
    # claude, codex, pi and omp take the instruction as a positional argument.
    claude|codex|pi|omp) exec "$agent" "$prompt" ;;
    # opencode: --prompt keeps the interactive interface ("run" would exit at once).
    opencode)            exec opencode --prompt "$prompt" ;;
    # Wrapper written by mise-install: we try the most common form.
    *)                   exec "$agent" "$prompt" ;;
  esac
}

# --- the shared usage renderer -----------------------------------------------
# The resets are printed in the box's timezone, and the proxy is reached at the
# address the entrypoint was given. Both live in /etc/devbox/env, which login
# shells source, but a caller may not have them in its environment. The
# subshell keeps everything else in that file out of this one.
from_devbox_env() {
  [ -r /etc/devbox/env ] || return 0
  # shellcheck source=/dev/null
  ( . /etc/devbox/env 2>/dev/null; printf '%s' "${!1:-}" )
}

if [ -z "${TZ:-}" ]; then
  TZ="$(from_devbox_env TZ)"
  if [ -n "$TZ" ]; then export TZ; else unset TZ; fi
fi
[ -n "${LLM_PROXY_URL:-}" ] || LLM_PROXY_URL="$(from_devbox_env LLM_PROXY_URL)"
[ -n "${LLM_PROXY_API_KEY:-}" ] || LLM_PROXY_API_KEY="$(from_devbox_env LLM_PROXY_API_KEY)"
LLM_PROXY_URL="${LLM_PROXY_URL:-http://llmproxy}"
# The trailing slash would double up in the route below.
LLM_PROXY_URL="${LLM_PROXY_URL%/}"

repeat() { local i s=""; for (( i = 0; i < $2; i++ )); do s+="$1"; done; printf '%s' "$s"; }

# Colors, once for every renderer below, and only on a terminal, so the output
# stays greppable in a pipe. C_BAR is the neutral one, for a bar that shows a
# share rather than how close a limit is.
C_OFF=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_BAR=""; C_BOLD=""; C_DIM=""
setup_colors() {
  [ -t 1 ] || return 0
  command -v tput >/dev/null 2>&1 || return 0
  C_OFF="$(tput sgr0 2>/dev/null || true)"
  C_GREEN="$(tput setaf 2 2>/dev/null || true)"
  C_YELLOW="$(tput setaf 3 2>/dev/null || true)"
  C_RED="$(tput setaf 1 2>/dev/null || true)"
  C_BAR="$(tput setaf 6 2>/dev/null || true)"
  C_BOLD="$(tput bold 2>/dev/null || true)"
  C_DIM="$(tput dim 2>/dev/null || true)"
}
setup_colors

# The one bar of this script: 20 cells filled to $1 percent, in the color $2.
# An empty percentage means unknown, and draws 20 blanks instead.
draw_bar() {
  local pct="${1:-}" color="${2:-}" filled
  if [ -z "$pct" ]; then repeat ' ' 20; return 0; fi
  filled=$(( pct * 20 / 100 ))
  # Something is not nothing: a share that rounds down to no cell still gets one.
  [ "$filled" -gt 0 ] || [ "$pct" -le 0 ] || filled=1
  printf '%s%s%s%s' "$color" "$(repeat '█' "$filled")" \
    "$(repeat '░' $(( 20 - filled )))" "$C_OFF"
}

# 12345 becomes 12.3k, 4500000 becomes 4.5M, anything under 1000 stays exact.
human_tokens() {
  local n="${1:-0}"
  if [ "$n" -lt 1000 ]; then printf '%s' "$n"
  elif [ "$n" -lt 1000000 ]; then printf '%d.%dk' $(( n / 1000 )) $(( (n % 1000) / 100 ))
  elif [ "$n" -lt 1000000000 ]; then printf '%d.%dM' $(( n / 1000000 )) $(( (n % 1000000) / 100000 ))
  else printf '%d.%dG' $(( n / 1000000000 )) $(( (n % 1000000000) / 100000000 ))
  fi
}

# 1030 becomes "1 030". A long number is only readable in groups.
group_digits() {
  local n="${1:-0}" out=""
  while [ "${#n}" -gt 3 ]; do
    out=" ${n: -3}$out"
    n="${n:0:${#n}-3}"
  done
  printf '%s%s' "$n" "$out"
}

# "1 request", "2 requests": the word that goes with a count.
plural() { local n="${1:-0}" word="$2"; printf '%s' "$word"; [ "$n" -eq 1 ] || printf 's'; }

# A model name cut to $2 columns. The vendor prefix goes first, since what
# tells two models apart sits at the end of the name, then the tail is cut.
fit_name() {
  local n="$1" w="$2"
  [ "${#n}" -le "$w" ] || n="${n##*/}"
  [ "${#n}" -le "$w" ] || n="${n:0:$(( w - 2 ))}.."
  printf '%s' "$n"
}

# The eight levels of a sparkline cell, lowest first.
SPARK_BLOCKS=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)

# One cell per day from the daily totals given as arguments, oldest first. The
# scale is the busiest of those days, so every line uses its full height. A day
# with nothing in it gets the lowest block rather than a hole, so the line
# reads as one shape.
spark_line() {
  local max=0 v idx out=""
  for v in "$@"; do [ "$v" -gt "$max" ] && max="$v"; done
  for v in "$@"; do
    if [ "$max" -le 0 ] || [ "$v" -le 0 ]; then idx=0
    else idx=$(( (v * 7 + max - 1) / max )); fi
    out+="${SPARK_BLOCKS[$idx]}"
  done
  printf '%s' "$out"
}

# --- the limit bars ----------------------------------------------------------
# Reads "label<TAB>percent<TAB>reset" lines on stdin, one per window, and
# prints an aligned label, a bar, the percentage, and how long is left before
# the window resets. percent is empty when unknown, reset is an ISO 8601
# timestamp, an epoch in seconds, or empty. Here the color is a warning, so it
# follows the percentage.
render_usage() {
  local -a labels=() pcts=() resets=()
  local label pct reset width=0

  while IFS=$'\t' read -r label pct reset; do
    [ -n "$label" ] || continue
    labels+=("$label"); pcts+=("${pct:-}"); resets+=("${reset:-}")
    [ "${#label}" -gt "$width" ] && width="${#label}"
  done
  [ "${#labels[@]}" -gt 0 ] || return 0

  local i n color when ts now today delta d h m clock
  now="$(date +%s)"
  today="$(date -d "@$now" +%F)"
  for i in "${!labels[@]}"; do
    pct="${pcts[$i]}"
    reset="${resets[$i]}"

    n=""
    case "$pct" in
      ''|*[!0-9]*) n="" ;;
      *) n="$pct"; [ "$n" -gt 100 ] && n=100 ;;
    esac
    color=""
    if [ -n "$n" ]; then
      if [ "$n" -lt 50 ]; then color="$C_GREEN"
      elif [ "$n" -lt 80 ]; then color="$C_YELLOW"
      else color="$C_RED"; fi
    fi

    # The reset, as a countdown in the box's local time.
    when=""
    ts=""
    if [ -n "$reset" ]; then
      case "$reset" in
        *[!0-9]*) ts="$(date -d "$reset" +%s 2>/dev/null || true)" ;;
        *) ts="$reset" ;;
      esac
    fi
    if [ -n "$ts" ]; then
      delta=$(( ts - now ))
      # The day is only worth printing when the reset is not today.
      if [ "$(date -d "@$ts" +%F)" = "$today" ]; then
        clock="$(date -d "@$ts" +%H:%M)"
      else
        clock="$(date -d "@$ts" '+%a %H:%M')"
      fi
      if [ "$delta" -le 0 ]; then
        when="  resets now"
      elif [ "$delta" -ge 86400 ]; then
        d=$(( delta / 86400 )); h=$(( (delta % 86400) / 3600 ))
        when="  resets in $d d $h h ($clock)"
      else
        h=$(( delta / 3600 )); m=$(( (delta % 3600) / 60 ))
        if [ "$h" -gt 0 ]; then
          when="  resets in $h h $m min ($clock)"
        else
          when="  resets in $m min ($clock)"
        fi
      fi
    fi

    printf '  %-*s  %s ' "$width" "${labels[$i]}" "$(draw_bar "$n" "$color")"
    if [ -n "$n" ]; then
      printf '%s%3d%%%s' "$color" "$n" "$C_OFF"
    else
      printf '%3s ' "?"
    fi
    printf '%s\n' "$when"
  done
}

# --- the tokens block --------------------------------------------------------
# One contract between the sources and the renderer, one TSV line per model and
# per day of the window:
#
#   model<TAB>day<TAB>requests<TAB>in<TAB>cached<TAB>out
#
# day is 0 for the oldest day of the window and 6 for today. "in" holds every
# input token, "cached" the part of it that came from a cache and is therefore
# already inside "in", "out" the output. A source with no meaningful request
# count emits 0, and the renderer drops the column when every count is 0. A
# line starting with "#" is a message, printed when the source has no row.
#
# Everything past that, totals, shares, sparklines, folding and widths, belongs
# to render_tokens and is written once. Adding a source is writing one jq
# program that emits those lines, and one two line section.

# The window: today and the six days before it, cut at local midnight in the
# box's timezone. TOK_DAYS holds the eight day boundaries, oldest first, which
# is what turns a timestamp into a day column.
TOK_WEEK0=""; TOK_DAYS=""
token_windows() {
  local i
  TOK_WEEK0="$(date -d '6 days ago 00:00' +%s)"
  TOK_DAYS=""
  for (( i = 6; i >= 0; i-- )); do
    TOK_DAYS="$TOK_DAYS$(date -d "$i days ago 00:00" +%s),"
  done
  TOK_DAYS="[$TOK_DAYS$(date -d 'tomorrow 00:00' +%s)]"
}

# The transcript files worth reading: the ones touched inside the window. A
# reference file is the portable way to say "newer than this epoch" to find.
# Fills the TOK_FILES array, empty when there is nothing to read.
TOK_FILES=()
token_files() {
  local dir="$1" ref
  TOK_FILES=()
  [ -d "$dir" ] || return 0
  ref="$(mktemp)" || return 0
  touch -d "@$TOK_WEEK0" "$ref" 2>/dev/null || { rm -f "$ref"; return 0; }
  mapfile -d '' -t TOK_FILES < <(find "$dir" -type f -name '*.jsonl' -newer "$ref" -print0 2>/dev/null)
  rm -f "$ref"
}

# The jq prelude every source shares: a number, a timestamp turned into a day
# column of the window, and collect(), which groups a stream of events into the
# lines of the contract. An event is { m: model, d: day, r, i, c, o }; events
# outside the window carry d = null and are dropped here.
# shellcheck disable=SC2016  # the $ names in there are jq's, not the shell's
TOKENS_JQ_PRELUDE='
  def num($v): if ($v | type) == "number" then $v else 0 end;
  # The agents write UTC, "2026-09-20T16:18:12.664Z". Cutting the string is a
  # lot cheaper than a regexp, and this runs once per line of every transcript.
  def epoch($v):
    if ($v | type) == "number" then $v
    elif ($v | type) == "string" and ($v | length) >= 19
    then ((($v[0:19] + "Z") | fromdateiso8601?) // 0)
    else 0 end;
  # Today first: that is where most of the events are.
  def dayof($v):
    epoch($v) as $t
    | if $t < $days[0] or $t >= $days[7] then null
      else first(range(6; -1; -1) | select($days[.] <= $t)) end;
  def collect(f):
    reduce (f | select(.d != null)) as $e ({};
      "\($e.m)\t\($e.d)" as $k
      | .[$k] = ((.[$k] // { r: 0, i: 0, c: 0, o: 0 })
                 | .r += $e.r | .i += $e.i | .c += $e.c | .o += $e.o))
    | to_entries[]
    | (.key | split("\t")) as $k
    | [ $k[0], $k[1], (.value.r | tostring),
        (.value.i | tostring), (.value.c | tostring), (.value.o | tostring) ]
    | @tsv;
'

# --- source: what Claude Code writes in ~/.claude/projects -------------------
# Every assistant line carries .message.usage and .message.model, and counts as
# one request. The four counters are disjoint there, so the input is the plain
# input plus what was written to the cache plus what was read from it, and both
# cache counters make up the cached part. "<synthetic>" is not a real call. One
# jq pass over the files, no shell loop on the lines.
tokens_claude() {
  command -v jq >/dev/null 2>&1 || { echo "#jq is missing"; return 1; }
  token_windows
  token_files "$HOME/.claude/projects"
  if [ "${#TOK_FILES[@]}" -eq 0 ]; then
    echo "#no local transcripts"
    return 0
  fi
  # Truncated or half written lines happen, fromjson? drops them.
  jq -nRr --argjson days "$TOK_DAYS" "$TOKENS_JQ_PRELUDE"'
    collect(
      inputs | (fromjson? // empty)
      | select(type == "object")
      | { ts: .timestamp, msg: (try .message catch null) }
      | select((.msg | type) == "object")
      | select((.msg.usage | type) == "object")
      | select((.msg.model | type) == "string" and .msg.model != "<synthetic>")
      | (num(.msg.usage.cache_read_input_tokens)
         + num(.msg.usage.cache_creation_input_tokens)) as $cached
      | { m: .msg.model, d: dayof(.ts // 0), r: 1,
          i: (num(.msg.usage.input_tokens) + $cached),
          c: $cached,
          o: num(.msg.usage.output_tokens) })
  ' "${TOK_FILES[@]}" 2>/dev/null || {
    echo "#unreadable transcripts in ~/.claude/projects"
    return 1
  }
}

# --- source: what codex writes in ~/.codex/sessions --------------------------
# A rollout file is one session. Its token_count events carry a running total
# for the session in info.total_token_usage, so what one event adds is its
# difference with the event before it in the same file, which is why the foreach
# below keeps state per input_filename. An event that adds something counts as
# one request. The model is whatever the file said last, on the session header
# or on a later settings event. cached_input_tokens is a part of input_tokens
# here, and cache writes are input as well.
# Format read off the codex protocol source, not verified against a real
# session: no box has one yet.
tokens_codex() {
  command -v jq >/dev/null 2>&1 || { echo "#jq is missing"; return 1; }
  token_windows
  token_files "$HOME/.codex/sessions"
  if [ "${#TOK_FILES[@]}" -eq 0 ]; then
    echo "#no local sessions"
    return 0
  fi
  jq -nRr --argjson days "$TOK_DAYS" "$TOKENS_JQ_PRELUDE"'
    def pos($v): if $v > 0 then $v else 0 end;
    collect(
      foreach ( inputs | (fromjson? // empty)
                | select(type == "object")
                | { f: input_filename, d: dayof(.timestamp // 0),
                    # The model moved around between versions, we take the
                    # first of the places it has been known to sit.
                    m: ( [ (try .payload.model catch null),
                           (try .payload.thread_settings.model catch null),
                           (try .payload.turn_context.model catch null),
                           (try .model catch null) ]
                         | map(select(type == "string" and . != "")) | first ),
                    u: ( (try .payload.info.total_token_usage catch null)
                         // (try .info.total_token_usage catch null) ) }
                | select(.m != null or (.u | type) == "object")
              ) as $l ({ file: null, model: null, prev: null, delta: null };
        # A new file starts a new session: no model and no running total yet.
        (if .file == $l.f then . else { file: $l.f, model: null, prev: null, delta: null } end)
        | (if $l.m != null then .model = $l.m else . end)
        | if ($l.u | type) != "object" then .delta = null
          else
            ($l.u | { i: (num(.input_tokens) + num(.cache_write_input_tokens)),
                      c: num(.cached_input_tokens),
                      o: num(.output_tokens) }) as $now
            | (.prev // { i: 0, c: 0, o: 0 }) as $was
            # A total that went down means the session was reset: take it whole.
            | (if $now.i >= $was.i and $now.o >= $was.o
               then $was else { i: 0, c: 0, o: 0 } end) as $base
            | .prev = $now
            | .delta = { i: pos($now.i - $base.i), c: pos($now.c - $base.c),
                         o: pos($now.o - $base.o) }
          end;
        if .delta == null or (.delta.i + .delta.o) <= 0 then empty
        else { m: (.model // "unknown"), d: $l.d, r: 1,
               i: .delta.i, c: .delta.c, o: .delta.o } end))
  ' "${TOK_FILES[@]}" 2>/dev/null || {
    echo "#unreadable sessions in ~/.codex/sessions"
    return 1
  }
}

# --- source: the OpenAI style usage route of the LLM proxy -------------------
# Hourly buckets from local midnight seven days back, so the day boundaries are
# the box's own and one single request covers the window. The proxy counts the
# requests itself. input_cached_tokens is a part of input_tokens.
tokens_proxy() {
  local start body data url page guard
  local -a page_arg=()
  for c in jq curl; do
    command -v "$c" >/dev/null 2>&1 || { echo "#$c is missing"; return 1; }
  done
  token_windows
  start="$TOK_WEEK0"
  url="$LLM_PROXY_URL/v1/organization/usage/completions"

  data=""
  page=""
  guard=0
  while :; do
    body="$(curl -fsS --max-time 10 \
        -H "Authorization: Bearer ${LLM_PROXY_API_KEY:-unused}" \
        -H "Accept: application/json" \
        --get --data-urlencode "start_time=$start" \
        --data-urlencode "bucket_width=1h" \
        --data-urlencode "group_by=model" \
        --data-urlencode "limit=168" \
        "${page_arg[@]}" \
        "$url" 2>/dev/null || true)"
    if [ -z "$body" ] || ! printf '%s' "$body" | jq -e 'type == "object"' >/dev/null 2>&1; then
      echo "#proxy at $LLM_PROXY_URL did not answer (network, or LLM_PROXY_URL not set)"
      return 1
    fi
    if printf '%s' "$body" | jq -e '.error' >/dev/null 2>&1; then
      printf '#proxy refused the request: %s\n' \
        "$(printf '%s' "$body" | jq -r '.error.message // "no reason given"')"
      return 1
    fi
    data="$data$(printf '%s' "$body" | jq -c '.data // [] | .[]')"$'\n'
    # A page that says there is more is followed, a few times at most.
    page="$(printf '%s' "$body" | jq -r 'if .has_more then (.next_page // "") else "" end')"
    guard=$(( guard + 1 ))
    [ -n "$page" ] && [ "$guard" -lt 4 ] || break
    page_arg=(--data-urlencode "page=$page")
  done

  printf '%s' "$data" | jq -rn --argjson days "$TOK_DAYS" "$TOKENS_JQ_PRELUDE"'
    collect(
      inputs | . as $b | (.results // [])[]
      | { m: (.model // "all models"), d: dayof(num($b.start_time)),
          r: num(.num_model_requests),
          i: num(.input_tokens), c: num(.input_cached_tokens),
          o: num(.output_tokens) })
  ' 2>/dev/null || {
    echo "#unexpected answer from the proxy at $LLM_PROXY_URL"
    return 1
  }
}

# --- the tokens renderer -----------------------------------------------------
# Reads the lines of the contract above on stdin and prints the block: a title
# carrying the totals of the window, one line per model with its share as a bar,
# a percentage, the tokens, the requests and a sparkline of its seven days, then
# the input and output totals and what today weighs. Sorted by tokens, largest
# first, everything past the eighth model folded into one line, so the block
# stays a glance and not a log. Lines are 80 columns at most, which is what caps
# the name column. $1 is the title, $2 is "bold" when that title is also the
# heading of its section, as it is for the proxy.
#
# $3 is the mode of the percentage next to the bar. The bar is always the share
# of the window's tokens. "share", the default, prints that share as the
# number, which is what Claude Code and Codex show. The proxy asks for "cache",
# the cache hit rate of the model, the part of its input served from the cache:
# red below 50, yellow below 80, green above, and "?" for a model that read no
# input at all. That mode also prints a header line naming the columns, right
# under the title.
render_tokens() {
  local title="${1:-Tokens, last 7 days}" weight="${2:-plain}" mode="${3:-share}"
  local -A tokens=() reqs=() days=() ins=() cacheds=()
  local -a msgs=() order=() names=() totals=() counts=() sparks=()
  local -a m_in=() m_cached=()
  local g_req=0 g_tok=0 g_in=0 g_cached=0 g_out=0 t_req=0 t_tok=0
  local model d r i c o line sum name maxw=27 width=0 keep=8
  local o_total=0 o_req=0 o_n=0 o_in=0 o_cached=0
  local -a o_days=(0 0 0 0 0 0 0)
  local idx pct n right pad head color bar

  while IFS=$'\t' read -r model d r i c o; do
    case "$model" in
      '#'*) msgs+=("${model#\#}"); continue ;;
      '') continue ;;
    esac
    sum=$(( i + o ))
    [ -n "${tokens[$model]:-}" ] || order+=("$model")
    tokens[$model]=$(( ${tokens[$model]:-0} + sum ))
    reqs[$model]=$(( ${reqs[$model]:-0} + r ))
    ins[$model]=$(( ${ins[$model]:-0} + i ))
    cacheds[$model]=$(( ${cacheds[$model]:-0} + c ))
    days["$model/$d"]=$(( ${days["$model/$d"]:-0} + sum ))
    g_req=$(( g_req + r )); g_tok=$(( g_tok + sum ))
    g_in=$(( g_in + i )); g_cached=$(( g_cached + c )); g_out=$(( g_out + o ))
    if [ "$d" = "6" ]; then t_req=$(( t_req + r )); t_tok=$(( t_tok + sum )); fi
  done

  head="$title"
  [ "$weight" = "bold" ] && head="$C_BOLD$title$C_OFF"

  if [ "${#order[@]}" -eq 0 ]; then
    printf '%s\n' "$head"
    for line in "${msgs[@]}"; do printf '  %s\n' "$line"; done
    return 0
  fi

  # Without a request count worth showing, the column goes rather than print
  # zeroes; the name column takes the room it leaves.
  # The percent sign travels with the number, so that a model with no rate to
  # show can print a bare "?" in that column.
  local fmt='  %-*s %s %s %7s %4s req %s\n'
  # The header of the cache mode: "share" over the bar, "cache" over the
  # percentage, and "req" on the right edge of the count it names.
  local hfmt="  ${C_DIM}%-*s %-20s %5s %7s %8s %s${C_OFF}\n"
  if [ "$g_req" -eq 0 ]; then
    fmt='  %-*s %s %s %7s %s\n'; maxw=36
    hfmt="  ${C_DIM}%-*s %-20s %5s %7s %s${C_OFF}\n"
  fi

  # Sorted on the tokens, largest first, then folded past the eighth model.
  # A fold of one line would save nothing: nine models are printed as nine.
  [ "${#order[@]}" -le $(( keep + 1 )) ] && keep="${#order[@]}"
  while read -r sum model; do
    if [ "${#names[@]}" -lt "$keep" ]; then
      names+=("$(fit_name "$model" "$maxw")"); totals+=("$sum"); counts+=("${reqs[$model]}")
      m_in+=("${ins[$model]}"); m_cached+=("${cacheds[$model]}")
      sparks+=("$(spark_line "${days["$model/0"]:-0}" "${days["$model/1"]:-0}" \
        "${days["$model/2"]:-0}" "${days["$model/3"]:-0}" "${days["$model/4"]:-0}" \
        "${days["$model/5"]:-0}" "${days["$model/6"]:-0}")")
    else
      o_n=$(( o_n + 1 )); o_total=$(( o_total + sum )); o_req=$(( o_req + reqs[$model] ))
      o_in=$(( o_in + ins[$model] )); o_cached=$(( o_cached + cacheds[$model] ))
      for idx in 0 1 2 3 4 5 6; do
        o_days[idx]=$(( o_days[idx] + ${days["$model/$idx"]:-0} ))
      done
    fi
  done < <(for name in "${order[@]}"; do printf '%s\t%s\n' "${tokens[$name]}" "$name"; done | sort -k1,1nr)

  if [ "$o_n" -gt 0 ]; then
    names+=("others ($o_n $(plural "$o_n" model))"); totals+=("$o_total"); counts+=("$o_req")
    m_in+=("$o_in"); m_cached+=("$o_cached")
    sparks+=("$(spark_line "${o_days[@]}")")
  fi
  for name in "${names[@]}"; do
    [ "${#name}" -gt "$width" ] && width="${#name}"
  done

  # The title, with the totals of the window pushed against the right margin.
  right="$(human_tokens "$g_tok") tokens"
  [ "$g_req" -gt 0 ] && right="$(group_digits "$g_req") $(plural "$g_req" request)   $right"
  pad=$(( 80 - ${#title} - ${#right} ))
  [ "$pad" -ge 1 ] || pad=1
  printf '%s%*s%s\n' "$head" "$pad" "" "$right"

  if [ "$mode" = "cache" ]; then
    local -a hcells=("$width" "model" "share" "cache" "tokens")
    [ "$g_req" -gt 0 ] && hcells+=("req")
    hcells+=("7 days")
    # shellcheck disable=SC2059  # hfmt is one of the two headers chosen above
    printf "$hfmt" "${hcells[@]}"
  fi

  local -a cells
  for idx in "${!names[@]}"; do
    # The bar is always the share of the window's tokens.
    pct=$(( totals[idx] * 100 / g_tok ))
    bar="$(draw_bar "$pct" "$C_BAR")"
    if [ "$mode" = "cache" ]; then
      # Next to it, the cache hit rate, the part of the input this model read
      # from the cache. A model that read nothing has no rate to show, only a
      # "?". The thresholds of render_usage, upside down: a high rate is good.
      if [ "${m_in[$idx]}" -le 0 ]; then
        n="?"
      else
        pct=$(( m_cached[idx] * 100 / m_in[idx] ))
        [ "$pct" -le 100 ] || pct=100
        if [ "$pct" -lt 50 ]; then color="$C_RED"
        elif [ "$pct" -lt 80 ]; then color="$C_YELLOW"
        else color="$C_GREEN"; fi
        n="$color$(printf '%4s' "$pct%")$C_OFF"
      fi
    else
      # A share below one percent has no cell to fill, but the line is still
      # there, and says so rather than showing a rounded zero.
      n="$pct%"
      [ "$pct" -lt 1 ] && n="<1%"
    fi
    # Padded here and not by the format, since the cache rate carries colour
    # codes that a printf width would count as characters.
    n="$(printf '%4s' "$n")"
    cells=("$width" "${names[$idx]}" "$bar" "$n"
           "$(human_tokens "${totals[$idx]}")")
    [ "$g_req" -gt 0 ] && cells+=("$(human_tokens "${counts[$idx]}")")
    cells+=("${sparks[$idx]}")
    # shellcheck disable=SC2059  # fmt is one of the two formats chosen above
    printf "$fmt" "${cells[@]}"
  done

  printf '  in %s, of which %s from the cache, out %s\n' \
    "$(human_tokens "$g_in")" "$(human_tokens "$g_cached")" "$(human_tokens "$g_out")"
  if [ "$g_req" -gt 0 ]; then
    printf '  today: %s %s, %s tokens\n' "$(group_digits "$t_req")" \
      "$(plural "$t_req" request)" "$(human_tokens "$t_tok")"
  else
    printf '  today: %s tokens\n' "$(human_tokens "$t_tok")"
  fi
}

# --- limits: Anthropic's OAuth endpoint --------------------------------------
# The token only leaves here in the Authorization header of that call, and
# nothing is written to disk.
limits_claude() {
  local creds="$HOME/.claude/.credentials.json" token payload tsv
  for c in jq curl; do
    command -v "$c" >/dev/null 2>&1 || { echo "dev-box-agent: $c is missing" >&2; return 1; }
  done
  if [ ! -r "$creds" ]; then
    echo "No Claude Code credentials in ~/.claude/.credentials.json."
    echo "Run 'claude', then /login, and try again."
    return 1
  fi
  token="$(jq -r '.claudeAiOauth.accessToken // empty' "$creds" 2>/dev/null || true)"
  if [ -z "$token" ]; then
    echo "No OAuth token in ~/.claude/.credentials.json."
    echo "Run 'claude', then /login, and try again."
    return 1
  fi

  payload="$(curl -fsS --max-time 15 \
      -H "Authorization: Bearer $token" \
      -H "anthropic-beta: oauth-2025-04-20" \
      -H "Accept: application/json" \
      https://api.anthropic.com/api/oauth/usage 2>/dev/null || true)"
  if [ -z "$payload" ]; then
    echo "Anthropic's endpoint answered nothing (network, expired token, or a rate limit on the check itself)."
    echo "Run 'claude' again to refresh the connection."
    return 1
  fi

  # The endpoint returns percentages (37.0) sometimes and fractions (0.37)
  # other times: one value >= 1 anywhere in the answer settles it for all.
  # One TSV line per window, "label<TAB>percent<TAB>reset", for render_usage.
  tsv="$(printf '%s' "$payload" | jq -r '
    def num($v): if ($v | type) == "number" then $v else null end;
    def row($label; $v; $reset; $scale):
      [ $label,
        (if $v == null then ""
         else (($v | if $scale then . else . * 100 end) | floor | tostring) end),
        (if ($reset // "") == "" then "" else ($reset | tostring) end) ]
      | @tsv;
    . as $p
    | ([num($p.five_hour.utilization),
        num(($p.seven_day_oauth_apps // $p.seven_day // {}).utilization)]
       + [($p.limits // [])[] | num(.percent)] | map(select(. != null))) as $all
    | (reduce $all[] as $v (false; . or ($v >= 1))) as $scale
    | [ (if $p.five_hour then row("5 h window"; num($p.five_hour.utilization);
                                  $p.five_hour.resets_at; $scale) else empty end),
        (($p.seven_day_oauth_apps // $p.seven_day) as $w
         | if $w then row("7 d window"; num($w.utilization); $w.resets_at; $scale) else empty end),
        (($p.limits // [])[] | select(.scope.model != null)
         | ((.kind // "") | ascii_downcase) as $k
         | (if ($k | test("hour|session")) then " (5 h)"
            elif ($k | test("month")) then " (month)"
            elif ($k | test("week|day")) then " (7 d)"
            else "" end) as $win
         | row(((.scope.model.display_name // .scope.model.id // "?") + $win);
               num(.percent); .resets_at; $scale))
      ]
    | .[]
  ' 2>/dev/null)" || {
    echo "  unexpected answer from Anthropic's endpoint"
    return 1
  }
  if [ -z "$tsv" ]; then
    echo "  no limit returned by the endpoint"
    return 0
  fi
  printf '%s\n' "$tsv" | render_usage
}

# --- limits: codex's own local app server ------------------------------------
# codex publishes no HTTP endpoint: its limits are read through the JSON-RPC
# protocol of "codex app-server", over standard input and output. We send the
# three messages at once and read the answer to request 2.
limits_codex() {
  local out plan tsv
  command -v jq >/dev/null 2>&1 || { echo "dev-box-agent: jq is missing" >&2; return 1; }
  command -v codex >/dev/null 2>&1 || { echo "dev-box-agent: codex is not on the PATH" >&2; return 1; }
  if [ ! -r "$HOME/.codex/auth.json" ]; then
    echo "No Codex credentials in ~/.codex/auth.json."
    echo "Run 'codex', then /login, and try again."
    return 1
  fi

  out="$(
    {
      printf '%s\n' '{"id":1,"method":"initialize","params":{"clientInfo":{"name":"dev-box-agent","version":"1"}}}'
      printf '%s\n' '{"method":"initialized","params":{}}'
      printf '%s\n' '{"id":2,"method":"account/rateLimits/read","params":{}}'
      # Keeps stdin open long enough for codex to answer.
      sleep 8
    } | timeout 25 codex -s read-only -a on-request app-server 2>/dev/null \
      | jq -c 'select(.id == 2) | .result.rateLimits // empty' 2>/dev/null | head -n 1
  )" || true

  if [ -z "$out" ]; then
    echo "codex returned no limits (version too old, or the session is not logged in)."
    echo "Run 'codex', then /status, to see them in the agent itself."
    return 1
  fi

  plan="$(printf '%s' "$out" | jq -r 'if .planType then "  plan: \(.planType)" else empty end' 2>/dev/null || true)"
  [ -n "$plan" ] && printf '%s\n' "$plan"

  # One TSV line per window, "label<TAB>percent<TAB>reset", for render_usage.
  # The app-server gives the reset as resetsAt, an epoch in seconds, on the
  # versions that carry it, and as a number of seconds left on some others.
  tsv="$(printf '%s' "$out" | jq -r '
    def win_label($m): if $m == 10080 then "7 d window"
                   elif ($m | type) == "number" and ($m % 60) == 0 then "\($m / 60 | floor) h window"
                   elif ($m | type) == "number" then "\($m) min window"
                   else "Limit" end;
    def reset($w):
      ($w.resetsAt // $w.resets_at) as $at
      | ($w.resetsInSeconds // $w.resets_in_seconds) as $in
      | if ($at | type) == "number" then ($at | floor | tostring)
        elif ($at | type) == "string" and $at != "" then $at
        elif ($in | type) == "number" then ((now + $in) | floor | tostring)
        else "" end;
    ( .primary, .secondary ) | select(. != null and .usedPercent != null)
      | [ win_label(.windowDurationMins), (.usedPercent | floor | tostring), reset(.) ]
      | @tsv
  ' 2>/dev/null)" || {
    echo "  unexpected answer from codex"
    return 1
  }
  if [ -z "$tsv" ]; then
    echo "  unexpected answer from codex"
    return 1
  fi
  printf '%s\n' "$tsv" | render_usage
}

# A section is a heading, the limits of the account when it has any, and the
# tokens block. The limits and the tokens are reported on their own, so an
# account that is not logged in still has its transcripts counted. The proxy
# has no heading of its own: its title carries it.
section_claude() {
  local rc=0
  printf '%sClaude Code%s\n' "$C_BOLD" "$C_OFF"
  limits_claude || rc=1
  tokens_claude | render_tokens "Tokens, last 7 days"
  [ "${PIPESTATUS[0]}" -eq 0 ] || rc=1
  return "$rc"
}

section_codex() {
  local rc=0
  printf '%sCodex%s\n' "$C_BOLD" "$C_OFF"
  limits_codex || rc=1
  tokens_codex | render_tokens "Tokens, last 7 days"
  [ "${PIPESTATUS[0]}" -eq 0 ] || rc=1
  return "$rc"
}

section_proxy() {
  tokens_proxy | render_tokens "LLM proxy, last 7 days" bold cache
  return "${PIPESTATUS[0]}"
}

do_usage() {
  local which="${1:-}" rc=0
  # No name: the three of them, each one saying by itself what it cannot read.
  if [ -z "$which" ]; then
    section_claude || rc=1
    echo
    section_codex || rc=1
    echo
    section_proxy || rc=1
    return "$rc"
  fi
  case "$which" in
    claude)          section_claude ;;
    codex)           section_codex ;;
    proxy|llmproxy)  section_proxy ;;
    *) echo "dev-box-agent: usage is only available for claude, codex and proxy" >&2; exit 2 ;;
  esac
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  which)
    if name="$(read_agent)" && [ -n "$name" ]; then
      printf '%s\n' "$name"
    else
      echo "no default agent (devbox agent set <name>)"
      exit 1
    fi
    exit 0
    ;;
  set)
    shift
    set_agent "${1:-}"
    exit 0
    ;;
  prompt)
    shift
    [ $# -gt 0 ] || { echo "usage: devbox agent prompt <text...>" >&2; exit 2; }
    agent="$(current_agent)" || exit 1
    run_with_prompt "$agent" "$*"
    ;;
  usage)
    shift
    do_usage "${1:-}"
    exit $?
    ;;
  "")
    # With a terminal: a menu of actions. Without one: run the default agent.
    if [ -t 0 ] && [ -t 2 ] && command -v gum >/dev/null 2>&1; then
      default="$(read_agent || true)"
      entries=()
      [ -n "$default" ] && entries+=("Run $default here")
      entries+=("Pick the default agent" "Usage: Claude Code" "Usage: Codex" "Usage: LLM proxy" "Usage: all")
      choice="$(printf '%s\n' "${entries[@]}" | gum choose --height 9 --header "Coding agent")" || exit 0
      case "$choice" in
        "Run "*)             exec "$default" ;;
        "Pick "*)            set_agent ""; exit 0 ;;
        "Usage: Claude"*)    do_usage claude; exit $? ;;
        "Usage: Codex")      do_usage codex; exit $? ;;
        "Usage: LLM proxy")  do_usage proxy; exit $? ;;
        "Usage: all")        do_usage; exit $? ;;
        *) exit 0 ;;
      esac
    fi
    agent="$(current_agent)" || exit 1
    exec "$agent"
    ;;
  -*) echo "dev-box-agent: unknown option '$1'" >&2; exit 2 ;;
  *)  echo "dev-box-agent: unknown subcommand '$1'" >&2; usage >&2; exit 2 ;;
esac
