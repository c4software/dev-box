#!/usr/bin/env bash
# devbox:name=agent
# devbox:summary=Default coding agent: run it, pick it, account usage
# devbox:args=[set|prompt|which|usage]
# One default agent for the box, remembered in ~/.config/dev-box/agent, on the
# model of omarchy-default-agent and omarchy-agent.
#
#   dev-box-agent                  menu: run the default agent, pick one, usage
#   dev-box-agent set [name]       change the default agent (menu with no name)
#   dev-box-agent which            print the default agent
#   dev-box-agent prompt <text...> run the agent with an instruction
#   dev-box-agent usage [claude|codex]
#                                  account limits, one bar per window with the
#                                  percentage used and the time left before it resets
#
# The agents on offer are the ones shipped by the image (claude, pi, omp,
# opencode, codex) plus the wrappers written by `devbox mise-install`.
set -euo pipefail

CONF_DIR="$HOME/.config/dev-box"
CONF="$CONF_DIR/agent"
BUILTIN=(claude pi omp opencode codex)

usage() { sed -n '5,17p' "$0" | sed 's/^# \?//'; }

# Early, so that `devbox agent --help` really finds a help to print.
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

# Available agents: the ones from the image, plus the mise-install wrappers.
available() {
  local a f name
  for a in "${BUILTIN[@]}"; do printf '%s\n' "$a"; done
  if [ -d "$HOME/.local/bin" ]; then
    for f in "$HOME/.local/bin"/*; do
      [ -f "$f" ] || continue
      grep -qxF '# dev-box-mise-install' "$f" || continue
      name="$(basename "$f")"
      printf '%s\n' "$name"
    done
  fi
}
available_sorted() { available | sort -u; }

read_agent() {
  [ -s "$CONF" ] || return 1
  head -n 1 "$CONF" | tr -d '[:space:]'
}

write_agent() {
  mkdir -p "$CONF_DIR"
  printf '%s\n' "$1" > "$CONF"
  echo "[dev-box-agent] default agent: $1"
}

# The gum menu. Without a terminal we refuse rather than wait for nothing.
# The callers capture the result with $(...), so stdout is never a terminal
# here: the test looks at stdin and stderr, which gum draws on.
choose_agent() {
  local chosen
  if [ ! -t 0 ] || [ ! -t 2 ]; then
    echo "dev-box-agent: no terminal for the menu." >&2
    echo "Give a name: devbox agent set <name>" >&2
    echo "On offer: $(available_sorted | tr '\n' ' ')" >&2
    return 1
  fi
  command -v gum >/dev/null 2>&1 || {
    echo "dev-box-agent: gum is missing, give a name: devbox agent set <name>" >&2
    return 1
  }
  chosen="$(available_sorted | gum choose --height 10 --header "Default coding agent")" || true
  [ -n "$chosen" ] || return 1
  printf '%s' "$chosen"
}

set_agent() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    name="$(choose_agent)" || exit 1
  fi
  if ! available_sorted | grep -qxF "$name"; then
    echo "dev-box-agent: '$name' is not an agent this box knows" >&2
    echo "On offer: $(available_sorted | tr '\n' ' ')" >&2
    echo "Another tool: devbox mise-install <package> <name>" >&2
    exit 1
  fi
  write_agent "$name"
}

# The default agent, asking for one when none has been picked yet.
current_agent() {
  local name
  if name="$(read_agent)" && [ -n "$name" ]; then
    printf '%s' "$name"
    return 0
  fi
  name="$(choose_agent)" || return 1
  write_agent "$name" >&2
  printf '%s' "$name"
}

# How each agent takes an instruction on its command line.
run_with_prompt() {
  local agent="$1" prompt="$2"
  case "$agent" in
    # claude, codex, pi and omp take the instruction as a positional argument.
    claude|codex|pi|omp) exec "$agent" "$prompt" ;;
    # opencode: --prompt keeps the interactive interface ("run" would exit at once).
    opencode)            exec opencode --prompt "$prompt" ;;
    # Wrapper written by mise-install: we try the most common form.
    *)                   exec "$agent" "$prompt" ;;
  esac
}

# --- the shared usage renderer -----------------------------------------------
# The resets are printed in the box's timezone. TZ lives in /etc/devbox/env,
# which login shells source, but a caller may not have it in its environment.
# The subshell keeps everything else in that file out of this one.
if [ -z "${TZ:-}" ] && [ -r /etc/devbox/env ]; then
  # shellcheck source=/dev/null
  TZ="$(. /etc/devbox/env 2>/dev/null; printf '%s' "${TZ:-}")"
  if [ -n "$TZ" ]; then export TZ; else unset TZ; fi
fi

repeat() { local i s=""; for (( i = 0; i < $2; i++ )); do s+="$1"; done; printf '%s' "$s"; }

# Reads "label<TAB>percent<TAB>reset" lines on stdin, one per window, and
# prints an aligned label, a 20 cell bar, the percentage, and how long is left
# before the window resets. percent is empty when unknown, reset is an ISO 8601
# timestamp, an epoch in seconds, or empty. Colors only on a terminal, so the
# output stays greppable in a pipe.
render_usage() {
  local -a labels=() pcts=() resets=()
  local label pct reset width=0

  while IFS=$'\t' read -r label pct reset; do
    [ -n "$label" ] || continue
    labels+=("$label"); pcts+=("${pct:-}"); resets+=("${reset:-}")
    [ "${#label}" -gt "$width" ] && width="${#label}"
  done
  [ "${#labels[@]}" -gt 0 ] || return 0

  local c_off="" c_green="" c_yellow="" c_red=""
  if [ -t 1 ] && command -v tput >/dev/null 2>&1; then
    c_off="$(tput sgr0 2>/dev/null || true)"
    c_green="$(tput setaf 2 2>/dev/null || true)"
    c_yellow="$(tput setaf 3 2>/dev/null || true)"
    c_red="$(tput setaf 1 2>/dev/null || true)"
  fi

  local i n filled color bar when ts now today delta d h m clock
  now="$(date +%s)"
  today="$(date -d "@$now" +%F)"
  for i in "${!labels[@]}"; do
    pct="${pcts[$i]}"
    reset="${resets[$i]}"

    n=""
    case "$pct" in
      ''|*[!0-9]*) n="" ;;
      *) n="$pct"; [ "$n" -gt 100 ] && n=100 ;;
    esac

    if [ -n "$n" ]; then
      filled=$(( n * 20 / 100 ))
      bar="$(repeat '█' "$filled")$(repeat '░' $(( 20 - filled )))"
      if [ "$n" -lt 50 ]; then color="$c_green"
      elif [ "$n" -lt 80 ]; then color="$c_yellow"
      else color="$c_red"; fi
    else
      bar="$(repeat ' ' 20)"
      color=""
    fi

    # The reset, as a countdown in the box's local time.
    when=""
    ts=""
    if [ -n "$reset" ]; then
      case "$reset" in
        *[!0-9]*) ts="$(date -d "$reset" +%s 2>/dev/null || true)" ;;
        *) ts="$reset" ;;
      esac
    fi
    if [ -n "$ts" ]; then
      delta=$(( ts - now ))
      # The day is only worth printing when the reset is not today.
      if [ "$(date -d "@$ts" +%F)" = "$today" ]; then
        clock="$(date -d "@$ts" +%H:%M)"
      else
        clock="$(date -d "@$ts" '+%a %H:%M')"
      fi
      if [ "$delta" -le 0 ]; then
        when="  resets now"
      elif [ "$delta" -ge 86400 ]; then
        d=$(( delta / 86400 )); h=$(( (delta % 86400) / 3600 ))
        when="  resets in $d d $h h ($clock)"
      else
        h=$(( delta / 3600 )); m=$(( (delta % 3600) / 60 ))
        if [ "$h" -gt 0 ]; then
          when="  resets in $h h $m min ($clock)"
        else
          when="  resets in $m min ($clock)"
        fi
      fi
    fi

    printf '  %-*s  %s%s%s ' "$width" "${labels[$i]}" "$color" "$bar" "$c_off"
    if [ -n "$n" ]; then
      printf '%s%3d%%%s' "$color" "$n" "$c_off"
    else
      printf '%3s ' "?"
    fi
    printf '%s\n' "$when"
  done
}

# --- usage claude: Anthropic's OAuth endpoint --------------------------------
# The token only leaves here in the Authorization header of that call, and
# nothing is written to disk.
usage_claude() {
  local creds="$HOME/.claude/.credentials.json" token payload tsv
  for c in jq curl; do
    command -v "$c" >/dev/null 2>&1 || { echo "dev-box-agent: $c is missing" >&2; return 1; }
  done
  if [ ! -r "$creds" ]; then
    echo "No Claude Code credentials in ~/.claude/.credentials.json."
    echo "Run 'claude', then /login, and try again."
    return 1
  fi
  token="$(jq -r '.claudeAiOauth.accessToken // empty' "$creds" 2>/dev/null || true)"
  if [ -z "$token" ]; then
    echo "No OAuth token in ~/.claude/.credentials.json."
    echo "Run 'claude', then /login, and try again."
    return 1
  fi

  payload="$(curl -fsS --max-time 15 \
      -H "Authorization: Bearer $token" \
      -H "anthropic-beta: oauth-2025-04-20" \
      -H "Accept: application/json" \
      https://api.anthropic.com/api/oauth/usage 2>/dev/null || true)"
  if [ -z "$payload" ]; then
    echo "Anthropic's endpoint answered nothing (network, expired token, or a rate limit on the check itself)."
    echo "Run 'claude' again to refresh the connection."
    return 1
  fi

  # The endpoint returns percentages (37.0) sometimes and fractions (0.37)
  # other times: one value >= 1 anywhere in the answer settles it for all.
  # One TSV line per window, "label<TAB>percent<TAB>reset", for render_usage.
  tsv="$(printf '%s' "$payload" | jq -r '
    def num($v): if ($v | type) == "number" then $v else null end;
    def row($label; $v; $reset; $scale):
      [ $label,
        (if $v == null then ""
         else (($v | if $scale then . else . * 100 end) | floor | tostring) end),
        (if ($reset // "") == "" then "" else ($reset | tostring) end) ]
      | @tsv;
    . as $p
    | ([num($p.five_hour.utilization),
        num(($p.seven_day_oauth_apps // $p.seven_day // {}).utilization)]
       + [($p.limits // [])[] | num(.percent)] | map(select(. != null))) as $all
    | (reduce $all[] as $v (false; . or ($v >= 1))) as $scale
    | [ (if $p.five_hour then row("5 h window"; num($p.five_hour.utilization);
                                  $p.five_hour.resets_at; $scale) else empty end),
        (($p.seven_day_oauth_apps // $p.seven_day) as $w
         | if $w then row("7 d window"; num($w.utilization); $w.resets_at; $scale) else empty end),
        (($p.limits // [])[] | select(.scope.model != null)
         | ((.kind // "") | ascii_downcase) as $k
         | (if ($k | test("hour|session")) then " (5 h)"
            elif ($k | test("month")) then " (month)"
            elif ($k | test("week|day")) then " (7 d)"
            else "" end) as $win
         | row(((.scope.model.display_name // .scope.model.id // "?") + $win);
               num(.percent); .resets_at; $scale))
      ]
    | .[]
  ' 2>/dev/null)" || {
    echo "  unexpected answer from Anthropic's endpoint"
    return 1
  }
  if [ -z "$tsv" ]; then
    echo "  no limit returned by the endpoint"
    return 0
  fi
  printf '%s\n' "$tsv" | render_usage
}

# --- usage codex: codex's own local app server -------------------------------
# codex publishes no HTTP endpoint: its limits are read through the JSON-RPC
# protocol of "codex app-server", over standard input and output. We send the
# three messages at once and read the answer to request 2.
usage_codex() {
  local out plan tsv
  command -v jq >/dev/null 2>&1 || { echo "dev-box-agent: jq is missing" >&2; return 1; }
  command -v codex >/dev/null 2>&1 || { echo "dev-box-agent: codex is not on the PATH" >&2; return 1; }
  if [ ! -r "$HOME/.codex/auth.json" ]; then
    echo "No Codex credentials in ~/.codex/auth.json."
    echo "Run 'codex', then /login, and try again."
    return 1
  fi

  out="$(
    {
      printf '%s\n' '{"id":1,"method":"initialize","params":{"clientInfo":{"name":"dev-box-agent","version":"1"}}}'
      printf '%s\n' '{"method":"initialized","params":{}}'
      printf '%s\n' '{"id":2,"method":"account/rateLimits/read","params":{}}'
      # Keeps stdin open long enough for codex to answer.
      sleep 8
    } | timeout 25 codex -s read-only -a on-request app-server 2>/dev/null \
      | jq -c 'select(.id == 2) | .result.rateLimits // empty' 2>/dev/null | head -n 1
  )" || true

  if [ -z "$out" ]; then
    echo "codex returned no limits (version too old, or the session is not logged in)."
    echo "Run 'codex', then /status, to see them in the agent itself."
    return 1
  fi

  plan="$(printf '%s' "$out" | jq -r 'if .planType then "  plan: \(.planType)" else empty end' 2>/dev/null || true)"
  [ -n "$plan" ] && printf '%s\n' "$plan"

  # One TSV line per window, "label<TAB>percent<TAB>reset", for render_usage.
  # The app-server gives the reset as resetsAt, an epoch in seconds, on the
  # versions that carry it, and as a number of seconds left on some others.
  tsv="$(printf '%s' "$out" | jq -r '
    def win_label($m): if $m == 10080 then "7 d window"
                   elif ($m | type) == "number" and ($m % 60) == 0 then "\($m / 60 | floor) h window"
                   elif ($m | type) == "number" then "\($m) min window"
                   else "Limit" end;
    def reset($w):
      ($w.resetsAt // $w.resets_at) as $at
      | ($w.resetsInSeconds // $w.resets_in_seconds) as $in
      | if ($at | type) == "number" then ($at | floor | tostring)
        elif ($at | type) == "string" and $at != "" then $at
        elif ($in | type) == "number" then ((now + $in) | floor | tostring)
        else "" end;
    ( .primary, .secondary ) | select(. != null and .usedPercent != null)
      | [ win_label(.windowDurationMins), (.usedPercent | floor | tostring), reset(.) ]
      | @tsv
  ' 2>/dev/null)" || {
    echo "  unexpected answer from codex"
    return 1
  }
  if [ -z "$tsv" ]; then
    echo "  unexpected answer from codex"
    return 1
  fi
  printf '%s\n' "$tsv" | render_usage
}

do_usage() {
  local which="${1:-}" rc=0
  # No name: both accounts, each one saying by itself when it is not logged in.
  if [ -z "$which" ]; then
    printf '\033[1mClaude Code\033[0m\n'; usage_claude || rc=1
    echo
    printf '\033[1mCodex\033[0m\n'; usage_codex || rc=1
    return "$rc"
  fi
  case "$which" in
    claude) printf '\033[1mClaude Code\033[0m\n'; usage_claude ;;
    codex)  printf '\033[1mCodex\033[0m\n'; usage_codex ;;
    *) echo "dev-box-agent: usage is only available for claude and codex" >&2; exit 2 ;;
  esac
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  which)
    if name="$(read_agent)" && [ -n "$name" ]; then
      printf '%s\n' "$name"
    else
      echo "no default agent (devbox agent set <name>)"
      exit 1
    fi
    exit 0
    ;;
  set)
    shift
    set_agent "${1:-}"
    exit 0
    ;;
  prompt)
    shift
    [ $# -gt 0 ] || { echo "usage: devbox agent prompt <text...>" >&2; exit 2; }
    agent="$(current_agent)" || exit 1
    run_with_prompt "$agent" "$*"
    ;;
  usage)
    shift
    do_usage "${1:-}"
    exit $?
    ;;
  "")
    # With a terminal: a menu of actions. Without one: run the default agent.
    if [ -t 0 ] && [ -t 2 ] && command -v gum >/dev/null 2>&1; then
      default="$(read_agent || true)"
      entries=()
      [ -n "$default" ] && entries+=("Run $default here")
      entries+=("Pick the default agent" "Usage: Claude Code" "Usage: Codex" "Usage: both")
      choice="$(printf '%s\n' "${entries[@]}" | gum choose --height 8 --header "Coding agent")" || exit 0
      case "$choice" in
        "Run "*)           exec "$default" ;;
        "Pick "*)          set_agent ""; exit 0 ;;
        "Usage: Claude"*)  do_usage claude; exit $? ;;
        "Usage: Codex")    do_usage codex; exit $? ;;
        "Usage: both")     do_usage; exit $? ;;
        *) exit 0 ;;
      esac
    fi
    agent="$(current_agent)" || exit 1
    exec "$agent"
    ;;
  -*) echo "dev-box-agent: unknown option '$1'" >&2; exit 2 ;;
  *)  echo "dev-box-agent: unknown subcommand '$1'" >&2; usage >&2; exit 2 ;;
esac
