#!/usr/bin/env bash
# devbox:name=update
# devbox:summary=Update dotfiles, mise tools and the shipped config
# devbox:args=[dotfiles|tools|seed|all]
# Updating the box by hand (nothing is automatic):
#   devbox update [dotfiles|tools|seed|all]   (default: all)
#
#   dotfiles  dotarchy-sync (config, try/proj, git aliases, local overrides)
#   tools     mise install, then mise upgrade
#   seed      config shipped by the image (agents, extensions, mise config)
#
# At the end, the update flag is cleared and the check runs again.
set -euo pipefail

WHAT="${1:-all}"
log() { echo "[dev-box-update] $*"; }
rc=0

do_dotfiles() {
  log "dotfiles..."
  dotarchy-sync || { log "⚠ dotarchy-sync failed"; rc=1; }
}

do_tools() {
  log "mise tools..."
  # install: what is missing; upgrade: bumps the tools pinned to "latest"
  if ! { mise install && mise upgrade; }; then
    log "⚠ mise failed"; rc=1
  fi
}

do_seed() {
  log "shipped config..."
  dev-box-seed || { log "⚠ dev-box-seed failed"; rc=1; }
}

case "$WHAT" in
  dotfiles) do_dotfiles ;;
  tools)    do_tools ;;
  seed)     do_seed ;;
  all)      do_dotfiles; do_tools; do_seed ;;
  -h|--help) sed -n '5,12p' "$0" | sed 's/^# \?//'; exit 0 ;;
  *) echo "usage: dev-box-update [dotfiles|tools|seed|all]" >&2; exit 2 ;;
esac

# The flag is recomputed right away: no message at the next login when
# everything is up to date.
rm -f "$HOME/.cache/dev-box/updates"
dev-box-check-updates || log "⚠ could not run the update check"

log "done"
exit "$rc"
