#!/usr/bin/env bash
# devbox:name=update
# devbox:summary=Met à jour dotfiles, outils mise et conf livrée
# devbox:args=[dotfiles|tools|seed|all]
# Mise à jour à la main de la box (rien n'est automatique) :
#   devbox update [dotfiles|tools|seed|all]   (défaut : all)
#
#   dotfiles  dotarchy-sync (conf, try/proj, alias git, surcouche locale)
#   tools     mise install puis mise upgrade
#   seed      conf livrée par l'image (agents, extensions, conf mise)
#
# À la fin, le drapeau de mises à jour est effacé et le contrôle relancé.
set -euo pipefail

WHAT="${1:-all}"
log() { echo "[dev-box-update] $*"; }
rc=0

do_dotfiles() {
  log "dotfiles…"
  dotarchy-sync || { log "⚠ dotarchy-sync a échoué"; rc=1; }
}

do_tools() {
  log "outils mise…"
  # install : ce qui manque ; upgrade : monte de version les outils en « latest »
  if ! { mise install && mise upgrade; }; then
    log "⚠ mise a échoué"; rc=1
  fi
}

do_seed() {
  log "conf livrée…"
  dev-box-seed || { log "⚠ dev-box-seed a échoué"; rc=1; }
}

case "$WHAT" in
  dotfiles) do_dotfiles ;;
  tools)    do_tools ;;
  seed)     do_seed ;;
  all)      do_dotfiles; do_tools; do_seed ;;
  -h|--help) sed -n '5,12p' "$0" | sed 's/^# \?//'; exit 0 ;;
  *) echo "usage : dev-box-update [dotfiles|tools|seed|all]" >&2; exit 2 ;;
esac

# Le drapeau est recalculé tout de suite : plus de message au prochain login si
# tout est à jour.
rm -f "$HOME/.cache/dev-box/updates"
dev-box-check-updates || log "⚠ contrôle des mises à jour impossible"

log "terminé"
exit "$rc"
