#!/usr/bin/env bash
# devbox:name=podman
# devbox:summary=docker/podman wrapper, says what to do when podman is off
# devbox:args=
# devbox:hidden=true
# Wrapper in front of `docker` and `podman` (links in /usr/local/bin, ahead of
# /usr/bin): when rootless podman is not enabled on this box, it says why and
# what to do, instead of letting podman fail on an obscure error.
# Bypass: PODMAN_FORCE=1, or /usr/bin/podman directly.
set -euo pipefail

sock="/run/user/$(id -u)/podman/podman.sock"
state="disabled"
[ -r /etc/devbox/podman.state ] && state="$(cat /etc/devbox/podman.state)"

if [ "${PODMAN_FORCE:-0}" != "1" ] && [ ! -S "$sock" ]; then
  name="$(basename "$0")"
  {
    echo "$name: podman is not active on this box."
    if [ "$state" != "enabled" ]; then
      echo "  Rootless podman is off (PODMAN_ENABLE missing or false in .env)."
      echo "  To turn it on, on the host:"
      echo "    1. uncomment the podman block of compose.override.example.yaml"
      echo "       (/dev/fuse + security_opt) in compose.override.yaml;"
      echo "    2. PODMAN_ENABLE=true in .env;"
      echo "    3. just up"
      echo "  That block loosens the isolation of the box: see 'Containers inside"
      echo "  the box' in the README."
    else
      echo "  PODMAN_ENABLE=true but the socket $sock is missing:"
      echo "  the service did not start. See ~/.cache/dev-box-podman.log and check"
      echo "  that compose.override.yaml really has the podman block (/dev/fuse, security_opt)."
    fi
    echo "  Force it anyway: PODMAN_FORCE=1 $name ..."
  } >&2
  exit 1
fi

case "$(basename "$0")" in
  docker) exec /usr/bin/docker "$@" ;;
  *)      exec /usr/bin/podman "$@" ;;
esac
