#!/usr/bin/env bash
# Stand-in for xdg-open in the box: there is no browser and no desktop here.
# What happens depends on the argument:
#   - a URL goes into the clipboard of the machine you are connected from
#     (through the wl-copy shim: tmux buffer and OSC 52), and a line says so;
#   - a directory opens in yazi, a file in $EDITOR (nvim), in a new tmux pane
#     next to the current one (below it, or to its right when the pane is wide
#     enough to be split in two), or in the foreground outside tmux;
#   - an image (SVG aside, which is text) is drawn by chafa in a floating tmux
#     pane centered over the window, closed by any key. Enter on a picture in
#     yazi lands here too.
# Anything that opens a link, gh auth login, claude, the OAuth flows of the
# agents, lands here: BROWSER=xdg-open is exported by /etc/devbox/zshenv,
# ahead of the dotarchy default. The `open` function of the dotarchy aliases
# (and the `repo` alias built on it) calls xdg-open with its output discarded,
# in the background: the tmux pane still opens, since tmux is reached through
# its socket, and a message that would be lost goes through notify-send too,
# which reaches the terminal over /dev/tty.
# Usage: xdg-open URL|FILE|DIRECTORY
set -euo pipefail

case "${1:-}" in
  ""|-h|--help)
    echo "Usage: xdg-open URL|FILE|DIRECTORY"
    echo "A URL is copied into the clipboard of your terminal; a directory opens in yazi"
    echo "and a file in \$EDITOR, in a tmux pane on the right (or here, outside tmux)."
    echo "An image is shown in a floating tmux pane over the window, any key closes it."
    exit 0 ;;
  --version)
    echo "xdg-open (dev-box shim)"; exit 0 ;;
esac

target="$1"

# say: on the terminal when there is one, through a notification otherwise.
say() {
  echo "$1"
  [ -t 1 ] || notify-send "dev-box" "$1" 2>/dev/null || true
}

# run: the command in a new tmux pane, or in the foreground. The split follows
# the shape of the current pane: side by side when it is more than three times
# wider than tall (a full-screen terminal, cells being about twice as tall as
# they are wide), stacked otherwise, so that both halves stay usable.
run_in_pane() {
  local dir="$1"; shift
  if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    local width height direction=-v
    read -r width height < <(tmux display-message -p '#{pane_width} #{pane_height}')
    [ "${width:-0}" -gt $(( ${height:-1} * 3 )) ] && direction=-h
    tmux split-window "$direction" -c "$dir" "$@"
  elif [ -t 0 ] && [ -t 1 ]; then
    cd "$dir" && exec "$@"
  else
    say "No tmux and no terminal to open it in, run it yourself: $*"
    exit 1
  fi
}

# view_image: chafa draws the picture in a floating tmux pane centered over the
# window, 90% of its size, then waits for a key and the pane goes away (or in
# the terminal itself outside tmux). A floating pane (tmux 3.7) rather than
# display-popup: a popup drops Sixel and passthrough, a pane gets Sixel from
# tmux and the Kitty protocol through passthrough, and chafa probes the
# terminal to pick what it speaks. A zoomed window is unzoomed first, a
# floating pane over it crashed tmux 3.7b.
view_image() {
  local file="$1" view
  if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    printf -v view 'chafa --align mid,mid -- %q; read -rsn1' "$file"
    if [ "$(tmux display-message -p '#{window_zoomed_flag}')" = 1 ]; then
      tmux resize-pane -Z
    fi
    tmux new-pane -x 90% -y 90% -X 5% -Y 5% -c "$(dirname "$file")" bash -c "$view"
  elif [ -t 0 ] && [ -t 1 ]; then
    chafa --align mid,mid -- "$file"
    read -rsn1
  else
    say "No tmux and no terminal to show it in, look at it in yazi: $file"
    exit 1
  fi
}

if [ -d "$target" ]; then
  dir="$(realpath "$target")"
  if ! command -v yazi >/dev/null 2>&1; then
    say "yazi is not installed, nothing to open the directory with: $dir"
    exit 1
  fi
  run_in_pane "$dir" yazi
elif [ -e "$target" ]; then
  file="$(realpath "$target")"
  case "$(file --brief --mime-type -- "$file")" in
    image/svg+xml) ;;
    image/*) view_image "$file"; exit 0 ;;
  esac
  run_in_pane "$(dirname "$file")" "${EDITOR:-nvim}" "$file"
else
  # A URL, or anything else: hand it over to the clipboard.
  if wl-copy "$target"; then
    say "Copied to the clipboard, paste it in a browser on your machine: $target"
  else
    say "Nothing to copy into, open this URL yourself: $target"
  fi
fi
