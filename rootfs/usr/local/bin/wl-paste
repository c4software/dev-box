#!/usr/bin/env bash
# The other half of wl-copy: prints the current tmux buffer (there is no read
# access to the remote terminal clipboard, OSC 52 only writes).
set -euo pipefail

if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  exec tmux save-buffer -
fi
echo "wl-paste: no tmux session, no buffer to read" >&2
exit 1
