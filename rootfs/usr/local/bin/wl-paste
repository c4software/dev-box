#!/usr/bin/env bash
# Pendant de wl-copy : rend le buffer tmux courant (pas d'accès au presse-papier
# du terminal distant, OSC 52 ne fait que l'écriture).
set -euo pipefail

if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  exec tmux save-buffer -
fi
echo "wl-paste : pas de session tmux, pas de buffer à lire" >&2
exit 1
