#!/usr/bin/env bash
# devbox:name=changelog
# devbox:summary=What changed in the box, newest first
# devbox:args=[-n N|--all|--upcoming]
#
# The release notes of the dev-box repository, read from its GitHub releases:
# one per v* tag, written in the annotation of the tag.
#
#   dev-box-changelog               the 3 latest releases, up to this image
#   dev-box-changelog -n 10         the 10 latest
#   dev-box-changelog --all         every release up to this image
#   dev-box-changelog --upcoming    the releases after this image
#   dev-box-changelog --new         the releases not seen yet, 3 at most
#   dev-box-changelog --mark-seen   remember this image as seen
#
# The notes are kept in ~/.cache/dev-box/releases.md. devbox check refreshes
# it in the background, and so does every call of this command but --new,
# which runs at login and reads the cache only: no network there. The version
# of the image last shown is kept in ~/.config/dev-box/changelog-seen, so the
# notes of an update show once, at the first login after it.
set -euo pipefail

# shellcheck source=/dev/null
. /usr/share/devbox/lib/release.sh

CACHE="$DEVBOX_RELEASES_CACHE"
SEEN="$HOME/.config/dev-box/changelog-seen"
DEFAULT_LIMIT=3
OWN="$(devbox_version)"

usage() { sed -n '6,20p' "$0" | sed 's/^# \?//'; }
err() { echo "dev-box-changelog: $*" >&2; }

C_OFF=""; C_HEAD=""; C_DIM=""; C_BOLD=""
if [ -t 1 ] && [ -n "${TERM:-}" ] && [ "${TERM}" != "dumb" ]; then
  C_OFF=$'\033[0m'; C_HEAD=$'\033[1;36m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
fi

# The tags of the cache, newest first.
tags() { [ -r "$CACHE" ] || return 0; sed -n 's/^## \([^ ]*\).*/\1/p' "$CACHE"; }

# An image built from a tag, or a local build described from one (v1.6-3-gabc):
# the releases can be placed before or after it. An older image only knows its
# commit.
own_is_versioned() { [[ "$OWN" =~ ^v[0-9] ]]; }

# The release is part of this image: not newer than its version.
in_box() { ! own_is_versioned || ! devbox_version_newer "$1" "$OWN"; }

# Prints the releases named in the arguments, in the order of the cache,
# `limit` of them at most (0 for all). The tag stands out, the date is dimmed,
# the notes are indented under them. With BRIEF=1, one line per release: the
# first line of its notes, next to the tag, for the login. A first line that
# starts with the tag ("v1.7: ...") loses it, the tag is already there.
render() {
  local limit="$1"; shift
  awk -v limit="$limit" -v sel=" $* " -v brief="${BRIEF:-0}" \
    -v o="$C_OFF" -v h="$C_HEAD" -v d="$C_DIM" '
    /^## / {
      keep = index(sel, " " $2 " ") > 0
      if (!keep) next
      n++
      if (limit > 0 && n > limit) exit
      tag = $2; first = 1
      if (brief) { printf "  %s%s%s  %s%s%s", h, tag, o, d, $3, o; next }
      if (n > 1) print ""
      printf "  %s%s%s  %s%s%s\n", h, tag, o, d, $3, o
      next
    }
    keep && NF {
      gsub(/`/, "")
      if (first) {
        first = 0
        if (index($0, tag ":") == 1) { $0 = substr($0, length(tag) + 2); sub(/^[ \t]+/, "") }
        if (brief) { printf "  %s\n", $0; next }
      }
      if (!brief) printf "    %s\n", $0
    }
    # A release with no notes still ends its line.
    brief && first == 1 && /^$/ && keep { print ""; first = 0 }
  ' "$CACHE"
}

# Live notes for the commands run by hand, the cache when GitHub is out of
# reach.
refresh() {
  if [ -z "$(devbox_github_repo 2>/dev/null || true)" ]; then
    err "the release notes are read from GitHub, and this image was built from ${DEVBOX_REPO:-an unknown repository}"
    exit 1
  fi
  devbox_refresh_releases 2>/dev/null && return 0
  if [ -r "$CACHE" ]; then
    printf '%sGitHub out of reach, notes as of %s%s\n\n' "$C_DIM" "$(date -r "$CACHE" +%F)" "$C_OFF"
  else
    err "could not read the releases of $(devbox_repo_url) (GITHUB_TOKEN helps with the rate limit)"
    exit 1
  fi
}

mark_seen() {
  [ -n "$OWN" ] || return 0
  mkdir -p "${SEEN%/*}"
  printf '%s\n' "$OWN" > "$SEEN"
}

list() {
  local t sel=() total
  for t in $(tags); do in_box "$t" && sel+=("$t"); done
  printf '%sdev-box changelog%s (this box runs %s)\n\n' "$C_BOLD" "$C_OFF" "$OWN"
  if [ "${#sel[@]}" -eq 0 ]; then
    echo "  No release notes up to $OWN yet."
    return 0
  fi
  render "$LIMIT" "${sel[@]}"
  total="${#sel[@]}"
  if [ "$LIMIT" -gt 0 ] && [ "$total" -gt "$LIMIT" ]; then
    printf '\n%s%s older releases: devbox changelog --all%s\n' \
      "$C_DIM" "$((total - LIMIT))" "$C_OFF"
  fi
  if ! own_is_versioned; then
    printf '\n%sthis image does not record its version: every release is listed%s\n' "$C_DIM" "$C_OFF"
  fi
}

upcoming() {
  local t sel=()
  own_is_versioned || {
    err "this image does not record its version, it cannot be placed among the releases: rebuild the container on the host"
    exit 1
  }
  for t in $(tags); do devbox_version_newer "$t" "$OWN" && sel+=("$t"); done
  if [ "${#sel[@]}" -eq 0 ]; then
    printf 'No release after %s.\n' "$OWN"
    [ "$DEVBOX_SOURCE" = "release" ] \
      || printf '%sa local build follows %s: devbox check --image says whether it moved%s\n' "$C_DIM" "$DEVBOX_BRANCH" "$C_OFF"
    return 0
  fi
  printf '%sComing after %s%s\n\n' "$C_BOLD" "$OWN" "$C_OFF"
  render 0 "${sel[@]}"
  if [ "$DEVBOX_SOURCE" = "release" ]; then
    printf '\n%spull the image and restart the container on the host to get it%s\n' "$C_DIM" "$C_OFF"
  else
    printf '\n%srebuild the container on the host to get it%s\n' "$C_DIM" "$C_OFF"
  fi
}

# What the login shows, from the cache only: the releases up to this image
# that were not shown yet. Nothing is recorded until the cache knows the
# release this image was built from, so notes fetched late still show once.
new() {
  local seen="" t sel=()
  [ -r "$CACHE" ] && own_is_versioned || exit 0
  [ -r "$SEEN" ] && IFS= read -r seen < "$SEEN" || true
  [ "$seen" != "$OWN" ] || exit 0
  if [ "$DEVBOX_SOURCE" = "release" ] && ! tags | grep -qxF "$OWN"; then
    exit 0
  fi
  for t in $(tags); do
    in_box "$t" || continue
    # A state from before the releases (a changelog heading) is no version:
    # the latest releases show, once.
    if [[ "$seen" =~ ^v[0-9] ]] && ! devbox_version_newer "$t" "$seen"; then continue; fi
    sel+=("$t")
  done
  if [ "${#sel[@]}" -gt 0 ]; then
    printf '%sNew in the box%s\n' "$C_BOLD" "$C_OFF"
    BRIEF=1 render "$DEFAULT_LIMIT" "${sel[@]}"
    printf '%sdevbox changelog for the details%s\n\n' "$C_DIM" "$C_OFF"
  fi
  mark_seen
}

MODE="list"
LIMIT="$DEFAULT_LIMIT"
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --all|-a) LIMIT=0; shift ;;
    -n)
      [ $# -ge 2 ] && [[ "$2" =~ ^[0-9]+$ ]] || { err "-n takes a number"; exit 2; }
      LIMIT="$2"; shift 2 ;;
    --new) MODE="new"; shift ;;
    --mark-seen) MODE="mark"; shift ;;
    --upcoming) MODE="upcoming"; shift ;;
    *) err "unknown option '$1'"; usage >&2; exit 2 ;;
  esac
done

case "$MODE" in
  mark) mark_seen ;;
  new) new ;;
  upcoming) refresh; upcoming ;;
  list) refresh; list; mark_seen ;;
esac
