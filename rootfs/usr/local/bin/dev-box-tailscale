#!/usr/bin/env bash
# devbox:name=tailscale
# devbox:summary=Taildrop: send, receive, tailnet status
# devbox:args=[send|receive|status]
# Moving files to and from the other machines of the tailnet, over Taildrop,
# plus the state of the link. Modelled on omarchy-tailscale-send and
# omarchy-tailscale-receive, without the desktop notifications.
#
#   dev-box-tailscale send <machine> <file...>   send over Taildrop
#   dev-box-tailscale receive [--once] [dir]     wait and store the files
#   dev-box-tailscale status                     state of the link and the peers
#
# The default receive directory is ~/inbox, created if missing.
set -euo pipefail

INBOX_DEFAULT="$HOME/inbox"

log() { echo "[dev-box-tailscale] $*"; }
usage() { sed -n '5,13p' "$0" | sed 's/^# \?//'; }

# The help stays readable even when Tailscale is off.
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

# TS_DISABLE is not in the environment of an SSH session: the entrypoint writes
# it into /etc/devbox/env, which login shells source.
if [ -z "${TS_DISABLE:-}" ] && [ -r /etc/devbox/env ]; then
  # shellcheck source=/dev/null
  . /etc/devbox/env
fi
if [ "${TS_DISABLE:-false}" = "true" ]; then
  echo "Tailscale is off on this box (TS_DISABLE=true)." >&2
  echo "The box goes through its own sshd: no Taildrop and no tailnet here." >&2
  exit 1
fi
command -v tailscale >/dev/null 2>&1 || {
  echo "dev-box-tailscale: tailscale is not on the PATH" >&2
  exit 1
}

do_send() {
  [ $# -ge 2 ] || { echo "usage: devbox tailscale send <machine> <file...>" >&2; exit 2; }
  local machine="$1"; shift
  local f
  for f in "$@"; do
    [ -e "$f" ] || { echo "dev-box-tailscale: $f does not exist" >&2; exit 1; }
  done
  log "sending $# file(s) to ${machine%%.*}"
  if tailscale file cp --update-interval=0 -- "$@" "$machine:"; then
    log "sent"
  else
    log "⚠ the send failed (machine offline, or Taildrop refused by the policy)"
    exit 1
  fi
}

do_receive() {
  local once=false dir
  if [ "${1:-}" = "--once" ]; then once=true; shift; fi
  dir="${1:-$INBOX_DEFAULT}"
  mkdir -p "$dir"
  log "receiving into $dir (Ctrl+C to stop)"
  while true; do
    if tailscale file get --wait --conflict=rename "$dir"; then
      log "file(s) received into $dir"
      $once && return 0
    else
      $once && { log "⚠ nothing received"; return 1; }
      sleep 10
    fi
  done
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  send)    do_send "$@" ;;
  receive) do_receive "$@" ;;
  status)  exec tailscale status ;;
  -h|--help|"") usage; [ -n "$cmd" ] || exit 2 ;;
  *) echo "dev-box-tailscale: unknown subcommand '$cmd'" >&2; usage >&2; exit 2 ;;
esac
