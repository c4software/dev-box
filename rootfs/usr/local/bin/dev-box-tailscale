#!/usr/bin/env bash
# devbox:name=tailscale
# devbox:summary=Taildrop : envoi, réception, état du tailnet
# devbox:args=[send|receive|status]
# Échange de fichiers avec les autres machines du tailnet, par Taildrop, plus
# l'état du lien. Sur le modèle d'omarchy-tailscale-send et
# d'omarchy-tailscale-receive, sans notifications de bureau.
#
#   dev-box-tailscale send <machine> <fichier…>  envoie par Taildrop
#   dev-box-tailscale receive [--once] [dossier] attend et range les fichiers
#   dev-box-tailscale status                     état du lien et des pairs
#
# Le dossier de réception par défaut est ~/inbox, créé au besoin.
set -euo pipefail

INBOX_DEFAULT="$HOME/inbox"

log() { echo "[dev-box-tailscale] $*"; }
usage() { sed -n '5,13p' "$0" | sed 's/^# \?//'; }

# L'aide reste lisible même quand Tailscale est coupé.
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

# TS_DISABLE n'est pas dans l'environnement d'une session SSH : l'entrypoint
# l'écrit dans /etc/devbox/env, que les shells de connexion sourcent.
if [ -z "${TS_DISABLE:-}" ] && [ -r /etc/devbox/env ]; then
  # shellcheck source=/dev/null
  . /etc/devbox/env
fi
if [ "${TS_DISABLE:-false}" = "true" ]; then
  echo "Tailscale désactivé sur cette box (TS_DISABLE=true)." >&2
  echo "La box passe par son propre sshd : ni Taildrop ni tailnet ici." >&2
  exit 1
fi
command -v tailscale >/dev/null 2>&1 || {
  echo "dev-box-tailscale : tailscale est absent du PATH" >&2
  exit 1
}

do_send() {
  [ $# -ge 2 ] || { echo "usage : devbox tailscale send <machine> <fichier…>" >&2; exit 2; }
  local machine="$1"; shift
  local f
  for f in "$@"; do
    [ -e "$f" ] || { echo "dev-box-tailscale : $f n'existe pas" >&2; exit 1; }
  done
  log "envoi de $# fichier(s) vers ${machine%%.*}"
  if tailscale file cp --update-interval=0 -- "$@" "$machine:"; then
    log "envoyé"
  else
    log "⚠ l'envoi a échoué (machine hors ligne, ou Taildrop refusé par la politique)"
    exit 1
  fi
}

do_receive() {
  local once=false dir
  if [ "${1:-}" = "--once" ]; then once=true; shift; fi
  dir="${1:-$INBOX_DEFAULT}"
  mkdir -p "$dir"
  log "réception dans $dir (Ctrl+C pour arrêter)"
  while true; do
    if tailscale file get --wait --conflict=rename "$dir"; then
      log "fichier(s) reçu(s) dans $dir"
      $once && return 0
    else
      $once && { log "⚠ rien reçu"; return 1; }
      sleep 10
    fi
  done
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  send)    do_send "$@" ;;
  receive) do_receive "$@" ;;
  status)  exec tailscale status ;;
  -h|--help|"") usage; [ -n "$cmd" ] || exit 2 ;;
  *) echo "dev-box-tailscale : sous-commande inconnue « $cmd »" >&2; usage >&2; exit 2 ;;
esac
