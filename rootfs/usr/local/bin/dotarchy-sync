#!/usr/bin/env bash
# devbox:name=sync
# devbox:summary=Pull the dotarchy dotfiles and apply them
# devbox:summary.fr=Récupérer les dotfiles dotarchy et les appliquer
# devbox:args=
# Pulls the config of dotarchy/common-no-omarchy (config/ and default/) and the
# base scripts its aliases need (try, proj, git aliases), without running the
# install scripts (bootstrap.sh, nvim.sh and friends).
# Runs on the first start, or by hand: `dotarchy-sync` (or `devbox update`).
set -euo pipefail

[ -f /etc/devbox/dotarchy.env ] && . /etc/devbox/dotarchy.env
REPO="${DOTARCHY_REPO:-https://github.com/c4software/dotarchy.git}"
BRANCH="${DOTARCHY_BRANCH:-main}"
SUBDIR="${DOTARCHY_SUBDIR:-common-no-omarchy}"

SRC="$HOME/.local/share/dotarchy"
STARTER="$HOME/.local/share/lazyvim-starter"
CFG="$SRC/$SUBDIR/config"
DEF="$SRC/$SUBDIR/default"

log() { echo "[dotarchy-sync] $*"; }

# --- 1. Clone or update (a read-only mirror of the repo) ---
if [ -d "$SRC/.git" ]; then
  before=$(git -C "$SRC" rev-parse --short HEAD)
  git -C "$SRC" remote set-url origin "$REPO"
  git -C "$SRC" fetch -q --depth 1 origin "$BRANCH"
  git -C "$SRC" reset -q --hard FETCH_HEAD
  after=$(git -C "$SRC" rev-parse --short HEAD)
  if [ "$before" = "$after" ]; then
    log "repo up to date ($after)"
  else
    log "repo updated from $before to $after"
  fi
else
  git clone -q --depth 1 --branch "$BRANCH" "$REPO" "$SRC"
  log "repo cloned ($(git -C "$SRC" rev-parse --short HEAD))"
fi

# --- 2. config/ into ~/.config (except nvim, handled apart) ---
mkdir -p "$HOME/.config"
rsync -a --exclude nvim "$CFG/" "$HOME/.config/"
log "config/ copied into ~/.config"

# --- 3. default/ into the home dotfiles ---
for f in zshrc bashrc profile; do
  [ -f "$DEF/$f" ] && cp "$DEF/$f" "$HOME/.$f"
done
log "default/ copied (.zshrc, .bashrc, .profile)"

# --- 4. nvim: config/nvim is a LazyVim overlay, laid on the official starter ---
if [ -d "$CFG/nvim" ]; then
  [ -d "$STARTER/.git" ] || git clone -q --depth 1 https://github.com/LazyVim/starter "$STARTER"
  git -C "$STARTER" pull -q --ff-only || true

  NVIM_DIR="$HOME/.config/nvim"
  if [ -d "$NVIM_DIR" ] && [ ! -f "$NVIM_DIR/.dotarchy-managed" ]; then
    mv "$NVIM_DIR" "$NVIM_DIR.bak.$(date +%Y%m%d%H%M%S)"
    log "old $NVIM_DIR saved as .bak"
  fi

  tmp=$(mktemp -d)
  rsync -a --exclude .git "$STARTER/" "$tmp/"
  rsync -a "$CFG/nvim/" "$tmp/"
  touch "$tmp/.dotarchy-managed"
  mkdir -p "$NVIM_DIR"
  # lazy-lock.json belongs to the box (versions of the installed plugins)
  rsync -a --delete --exclude lazy-lock.json "$tmp/" "$NVIM_DIR/"
  rm -rf "$tmp"
  log "nvim: LazyVim starter + config/nvim"
fi

# --- 5. Base scripts used by the aliases ---
# try / proj: the same downloads as install/bootstrap.sh (read from the script,
# so any new tool added to the repo the same way follows automatically)
mkdir -p "$HOME/.local/bin"
# (`|| true`: without bootstrap.sh, or with no line found, pipefail would stop the script)
{ grep -oE 'curl -sL https://[^ ]+ -o ~/.local/bin/[A-Za-z0-9._-]+' \
       "$SRC/$SUBDIR/install/bootstrap.sh" 2>/dev/null || true; } \
| while read -r _ _ url _ dest; do
    name=$(basename "$dest")
    if curl -fsSL "$url" -o "$HOME/.local/bin/$name.tmp"; then
      mv "$HOME/.local/bin/$name.tmp" "$HOME/.local/bin/$name"
      chmod +x "$HOME/.local/bin/$name"
      log "~/.local/bin/$name up to date"
    else
      rm -f "$HOME/.local/bin/$name.tmp"
      log "⚠ could not download $name"
    fi
  done

# Git aliases: the setup() function of install/git.sh (only `git config --global` calls)
if [ -f "$SRC/$SUBDIR/install/git.sh" ]; then
  # The file comes from the dotarchy clone, shellcheck cannot follow it.
  # shellcheck source=/dev/null
  ( . "$SRC/$SUBDIR/install/git.sh" && setup ) && log "git aliases applied (git.sh)"
fi

# --- 6. Reload tmux when it is running ---
if tmux info &>/dev/null && [ -f "$HOME/.config/tmux/tmux.conf" ]; then
  tmux source-file "$HOME/.config/tmux/tmux.conf" && log "tmux reloaded"
fi

# --- 7. Local overrides: ~/.config/dev-box/overrides mirrors the home tree and
#        is re-applied last (after the rsync --delete of nvim) ---
OVERRIDES="$HOME/.config/dev-box/overrides"
if [ -d "$OVERRIDES" ]; then
  n=$(find "$OVERRIDES" -type f | wc -l)
  if [ "$n" -gt 0 ]; then
    rsync -a "$OVERRIDES/" "$HOME/"
    log "local overrides applied ($n file(s) from ~/.config/dev-box/overrides)"
  fi
fi
