#!/usr/bin/env bash
# devbox:name=mise-install
# devbox:summary=Write a mise-backed wrapper for a tool into ~/.local/bin
# devbox:args=[<package> [cmd [binary]]|--list|--remove cmd]
# Wrapper generator, on the model of omarchy-mise-install: it writes a small
# script into ~/.local/bin that installs the tool on the first call, then runs
# it through mise. The image already ships claude, pi, omp, codex and
# opencode; this is for everything else (gemini, crush, copilot and so on).
#
#   dev-box-mise-install <package> [command [binary]]
#   dev-box-mise-install --list            the wrappers written here
#   dev-box-mise-install --remove <cmd>    delete one of them
#   dev-box-mise-install                   menu: write, list or remove, gum asks the rest
#
# Examples:
#   dev-box-mise-install npm:@google/gemini-cli gemini
#   dev-box-mise-install crush
#
# ~/.local/bin comes before /usr/local/bin on the PATH: a wrapper written here
# takes over from the one in the image when it carries the same name.
set -euo pipefail

BIN_DIR="$HOME/.local/bin"
# Marker: this is what tells our wrappers from the user's own scripts.
MARK="# dev-box-mise-install"

usage() { sed -n '5,20p' "$0" | sed 's/^# \?//'; }

is_generated() {
  [ -f "$1" ] || return 1
  grep -qxF "$MARK" "$1"
}

# The command name becomes a file name: a slash would write (and delete)
# somewhere else, a leading dot hides the file or climbs a level, and a leading
# dash gives a name that reads like an option.
check_name() {
  case "$1" in
    */* | .* | -* | *[[:cntrl:]]*)
      echo "dev-box-mise-install: '$1' is not a usable command name" >&2
      exit 1
      ;;
  esac
}

do_list() {
  local f name pkg found=false
  [ -d "$BIN_DIR" ] || { echo "no wrapper (no $BIN_DIR)"; return 0; }
  for f in "$BIN_DIR"/*; do
    [ -f "$f" ] || continue
    is_generated "$f" || continue
    found=true
    name="$(basename "$f")"
    pkg="$(awk '/^mise use -g --quiet /{ gsub(/"/, "", $5); print $5; exit }' "$f")"
    printf '  %-20s %s\n' "$name" "$pkg"
  done
  $found || echo "  no wrapper written by dev-box-mise-install"
}

do_remove() {
  local cmd="$1" f
  check_name "$cmd"
  f="$BIN_DIR/$cmd"
  if [ ! -e "$f" ]; then
    echo "dev-box-mise-install: $f does not exist" >&2
    exit 1
  fi
  if ! is_generated "$f"; then
    echo "dev-box-mise-install: $f was not written here, nothing deleted" >&2
    exit 1
  fi
  rm -f "$f"
  echo "[dev-box-mise-install] wrapper deleted: ~/.local/bin/$cmd"
}

generated_names() {
  local f
  [ -d "$BIN_DIR" ] || return 0
  for f in "$BIN_DIR"/*; do
    [ -f "$f" ] && is_generated "$f" && basename "$f"
  done
  return 0
}

# Without arguments, on a terminal: a gum menu, then the package and the
# command name are asked for. Without a terminal the usage is printed.
menu() {
  local choice pkg cmd guess names
  choice="$(printf '%s\n' \
      "write    a wrapper for a tool (package, then command name)" \
      "list     the wrappers written here" \
      "remove   delete one of them" \
    | gum choose --height 5 --header "mise-backed wrappers in ~/.local/bin")" || exit 0
  [ -n "$choice" ] || exit 0
  case "${choice%% *}" in
    write)
      pkg="$(gum input --placeholder "npm:@google/gemini-cli, crush, github:owner/repo" \
             --header "mise package")" || exit 0
      [ -n "$pkg" ] || { echo "no package given" >&2; exit 2; }
      # The command name defaults to the last part of the package, without
      # its backend: npm:@google/gemini-cli gives gemini-cli.
      guess="${pkg##*/}"; guess="${guess##*:}"; guess="${guess%%@*}"
      cmd="$(gum input --value "$guess" --header "Command name in ~/.local/bin")" || exit 0
      [ -n "$cmd" ] || cmd="$guess"
      exec "$0" "$pkg" "$cmd"
      ;;
    list) do_list; exit 0 ;;
    remove)
      names="$(generated_names)"
      [ -n "$names" ] || { echo "no wrapper written by dev-box-mise-install"; exit 0; }
      cmd="$(printf '%s\n' "$names" | gum choose --height 10 --header "Wrapper to delete")" || exit 0
      [ -n "$cmd" ] || exit 0
      do_remove "$cmd"
      exit 0
      ;;
  esac
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --list)    do_list; exit 0 ;;
  --remove)
    [ -n "${2:-}" ] || { echo "dev-box-mise-install: --remove expects a name" >&2; exit 2; }
    do_remove "$2"
    exit 0
    ;;
  "")
    if [ -t 0 ] && [ -t 1 ] && command -v gum >/dev/null 2>&1; then
      menu
    fi
    usage >&2; exit 2
    ;;
  -*) echo "dev-box-mise-install: unknown option '$1'" >&2; exit 2 ;;
esac

package="$1"
command_name="${2:-$1}"
bin_name="${3:-$command_name}"
check_name "$command_name"

# The heredoc below is not quoted: what follows is written as-is into the
# wrapper, so a package name carrying shell characters has to stay a single
# argument instead of being executed.
printf -v package_arg '%q' "$package"
printf -v bin_arg '%q' "$bin_name"
# What is inert between quotes keeps the readable shape of the image wrappers
# (npm:@scope/tool, github:author/repo), which %q would escape for nothing.
# shellcheck disable=SC1003  # the pattern looks for a backslash, not a quote
case "$package" in
  *'$'* | *'`'* | *'"'* | *'\'* | *'!'* | *[[:cntrl:]]*) ;;
  *) package_arg="\"$package\"" ;;
esac
# shellcheck disable=SC1003
case "$bin_name" in
  *'$'* | *'`'* | *'"'* | *'\'* | *'!'* | *[[:cntrl:]]*) ;;
  *) bin_arg="\"$bin_name\"" ;;
esac

target="$BIN_DIR/$command_name"
if [ -e "$target" ] && ! is_generated "$target"; then
  echo "dev-box-mise-install: ~/.local/bin/$command_name already exists and was" >&2
  echo "  not written here, nothing overwritten. Pick another command name." >&2
  exit 1
fi

mkdir -p "$BIN_DIR"
rm -f "$target"
# MISE_MINIMUM_RELEASE_AGE=0: asking for a tool by name means asking for it
# now, not in 24 h (mise quarantines the new releases).
cat > "$target" <<EOF
#!/bin/bash
$MARK
export MISE_MINIMUM_RELEASE_AGE=0
mise use -g --quiet $package_arg || exit 1
exec mise x $package_arg -- $bin_arg "\$@"
EOF
chmod +x "$target"

echo "[dev-box-mise-install] wrapper written: ~/.local/bin/$command_name ($package)"
echo "  first call: mise installs the tool, the next ones are instant"
