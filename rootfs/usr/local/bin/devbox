#!/usr/bin/env bash
# Centre de commande de la box : une seule porte d'entrée pour les outils
# dev-box-*, sur le modèle du dispatcher `omarchy` de l'hôte.
#
#   devbox                 menu de sélection (gum), puis exécution
#   devbox <cmd> [args…]   exécute la commande
#   devbox <cmd> --help    résumé, usage, puis l'aide du binaire s'il en a une
#   devbox --help          usage et tableau des commandes
#   devbox commands        la même liste, sans en-tête (pour les complétions)
#
# Les commandes ne sont pas codées ici : elles sont découvertes en lisant les
# en-têtes de commentaires des exécutables de /usr/local/bin.
#
#   # devbox:name=update
#   # devbox:summary=Met à jour dotfiles, outils mise et conf livrée
#   # devbox:args=[dotfiles|tools|seed|all]
#   # devbox:hidden=true     (facultatif : hors menu et hors liste, mais routable)
#
# Ajouter une commande, c'est donc poser un exécutable avec ces trois lignes.
set -euo pipefail

BIN_DIR="/usr/local/bin"
SCAN_LINES=30

NAMES=()
declare -A CMD_BIN CMD_SUMMARY CMD_ARGS CMD_HIDDEN

# Lit les en-têtes « # devbox: » des exécutables de BIN_DIR. Les liens
# symboliques sont ignorés : docker et podman pointent tous les deux sur
# dev-box-podman et donneraient trois fois la même commande.
discover() {
  local f header name summary args hidden line key value
  for f in "$BIN_DIR"/*; do
    [ -f "$f" ] || continue
    [ -L "$f" ] && continue
    [ -x "$f" ] || continue
    header="$(head -n "$SCAN_LINES" "$f" 2>/dev/null | grep -a '^# devbox:' || true)"
    [ -n "$header" ] || continue

    name=""; summary=""; args=""; hidden="false"
    while IFS= read -r line; do
      line="${line#\# devbox:}"
      key="${line%%=*}"
      value="${line#*=}"
      case "$key" in
        name)    name="$value" ;;
        summary) summary="$value" ;;
        args)    args="$value" ;;
        hidden)  hidden="$value" ;;
      esac
    done <<< "$header"

    [ -n "$name" ] || continue
    [ -n "${CMD_BIN[$name]:-}" ] && continue
    NAMES+=("$name")
    CMD_BIN["$name"]="$f"
    CMD_SUMMARY["$name"]="$summary"
    CMD_ARGS["$name"]="$args"
    CMD_HIDDEN["$name"]="$hidden"
  done
  # Ordre stable, quel que soit l'ordre de lecture du répertoire.
  if [ "${#NAMES[@]}" -gt 0 ]; then
    mapfile -t NAMES < <(printf '%s\n' "${NAMES[@]}" | sort)
  fi
}

visible_names() {
  local n
  for n in "${NAMES[@]}"; do
    [ "${CMD_HIDDEN[$n]}" = "true" ] || printf '%s\n' "$n"
  done
}

# printf « %-10s » compte des octets : un résumé accentué ou un « … » dans les
# arguments décalerait les colonnes. On complète nous-mêmes, sur ${#s} qui compte
# bien des caractères.
pad() {
  local s="$1" n=$(( $2 - ${#1} ))
  [ "$n" -lt 0 ] && n=0
  printf '%s%*s' "$s" "$n" ''
}

# Une ligne de tableau : nom, arguments, résumé.
print_table() {
  local n
  while IFS= read -r n; do
    printf '  \033[36m%s\033[0m %s %s\n' \
      "$(pad "$n" 9)" "$(pad "${CMD_ARGS[$n]}" 26)" "${CMD_SUMMARY[$n]}"
  done < <(visible_names)
}

usage() {
  cat <<'EOT'
devbox : commandes de la box de dev.

Usage :
  devbox                 menu de sélection
  devbox <cmd> [args…]   exécute une commande
  devbox <cmd> --help    aide de la commande
  devbox commands        liste brute des commandes

EOT
  printf '\033[1mCommandes\033[0m\n'
  print_table
}

unknown() {
  echo "devbox : commande inconnue « $1 »" >&2
  echo >&2
  print_table >&2
  exit 2
}

# Aide d'une commande : l'en-tête d'abord (toujours disponible), puis l'aide du
# binaire quand il en gère une. Le test reste une lecture du source, sans rien
# exécuter à l'aveugle.
cmd_help() {
  local name="$1" bin="${CMD_BIN[$1]}"
  printf '\033[1m%s\033[0m : %s\n' "$name" "${CMD_SUMMARY[$name]}"
  printf 'Usage : devbox %s %s\n' "$name" "${CMD_ARGS[$name]}"
  if head -n 200 "$bin" 2>/dev/null | grep -qa -- '--help'; then
    echo
    "$bin" --help || true
  fi
}

menu() {
  local lines=() n chosen
  while IFS= read -r n; do
    lines+=("$(printf '%s %s' "$(pad "$n" 9)" "${CMD_SUMMARY[$n]}")")
  done < <(visible_names)

  if [ "${#lines[@]}" -eq 0 ]; then
    echo "devbox : aucune commande trouvée dans $BIN_DIR" >&2
    exit 1
  fi
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "devbox : pas de terminal, le menu a besoin d'un tty." >&2
    echo "Donnez une commande : devbox <cmd>." >&2
    echo >&2
    print_table >&2
    exit 2
  fi
  command -v gum >/dev/null 2>&1 || {
    echo "devbox : gum est absent, donnez une commande : devbox <cmd>." >&2
    exit 1
  }

  chosen="$(printf '%s\n' "${lines[@]}" \
    | gum choose --height 12 --header "Commandes de la box")" || true
  [ -n "$chosen" ] || exit 0
  chosen="${chosen%% *}"
  exec "${CMD_BIN[$chosen]}"
}

discover
[ "${#NAMES[@]}" -gt 0 ] || { echo "devbox : aucune commande trouvée dans $BIN_DIR" >&2; exit 1; }

case "${1:-}" in
  "")            menu ;;
  -h|--help|help) usage; exit 0 ;;
  commands)      visible_names; exit 0 ;;
  -*)            unknown "$1" ;;
esac

name="$1"; shift
[ -n "${CMD_BIN[$name]:-}" ] || unknown "$name"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cmd_help "$name"
  exit 0
fi

exec "${CMD_BIN[$name]}" "$@"
