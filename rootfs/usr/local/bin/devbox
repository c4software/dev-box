#!/usr/bin/env bash
# Command center of the box: a single front door to the dev-box-* tools, built
# on the model of the `omarchy` dispatcher on the host.
#
#   devbox                 selection menu (gum), then it runs
#   devbox <cmd> [args...] run the command
#   devbox <cmd> --help    summary, usage, then the binary's own help if it has one
#   devbox --help          usage and the table of commands
#   devbox commands        the same list, without a header (for completions)
#
# The commands are not hardcoded here. They are discovered by reading the
# comment headers of the executables of /usr/local/bin.
#
#   # devbox:name=update
#   # devbox:summary=Update dotfiles, mise tools and the shipped config
#   # devbox:summary.fr=Mettre à jour les dotfiles, les outils mise et la config livrée
#                            (optional: replaces the summary when LANG is French)
#   # devbox:args=[dotfiles|tools|seed|all]
#   # devbox:hidden=true     (optional: out of the menu and the list, still routable)
#   # devbox:requires=tailscale   (optional: hidden too when that feature is off)
#
# Adding a command therefore means dropping an executable with those three lines.
#
# The summaries are the one part of this list that is translated: a
# summary.<lang> line (summary.fr) replaces the summary when the language of
# the locale is <lang> (see /usr/share/devbox/lib/lang.sh), and a command
# without one keeps its English summary. Nothing else is translated.
set -euo pipefail

DEVBOX_LANG=""
if [ -r /usr/share/devbox/lib/lang.sh ]; then
  . /usr/share/devbox/lib/lang.sh
  devbox_lang
fi

BIN_DIR="/usr/local/bin"
SCAN_LINES=30

NAMES=()
declare -A CMD_BIN CMD_SUMMARY CMD_ARGS CMD_HIDDEN

# A command can depend on a feature of the box. When that feature is off, the
# command leaves the menu and the list, but stays callable by name: it then
# prints its own explanation. TS_DISABLE is not in the environment of an SSH
# session, the entrypoint writes it to /etc/devbox/env.
feature_available() {
  case "$1" in
    tailscale)
      local ts="${TS_DISABLE:-}"
      if [ -z "$ts" ] && [ -r /etc/devbox/env ]; then
        ts="$(sed -n 's/^export TS_DISABLE=//p' /etc/devbox/env | tail -n 1)"
      fi
      [ "${ts:-false}" != "true" ]
      ;;
    podman) [ -S "/run/user/$(id -u)/podman/podman.sock" ] ;;
    *) return 0 ;;
  esac
}

# Reads the "# devbox:" headers of the executables of BIN_DIR. Symbolic links
# are skipped: docker and podman both point at dev-box-podman and would give
# the same command three times.
discover() {
  local f header name summary summary_l10n args hidden requires line key value
  for f in "$BIN_DIR"/*; do
    [ -f "$f" ] || continue
    [ -L "$f" ] && continue
    [ -x "$f" ] || continue
    header="$(head -n "$SCAN_LINES" "$f" 2>/dev/null | grep -a '^# devbox:' || true)"
    [ -n "$header" ] || continue

    name=""; summary=""; summary_l10n=""; args=""; hidden="false"; requires=""
    while IFS= read -r line; do
      line="${line#\# devbox:}"
      key="${line%%=*}"
      value="${line#*=}"
      case "$key" in
        name)    name="$value" ;;
        summary) summary="$value" ;;
        summary.*)
          if [ -n "$DEVBOX_LANG" ] && [ "$key" = "summary.$DEVBOX_LANG" ]; then
            summary_l10n="$value"
          fi ;;
        args)    args="$value" ;;
        hidden)  hidden="$value" ;;
        requires) requires="$value" ;;
      esac
    done <<< "$header"

    [ -n "$name" ] || continue
    [ -n "${CMD_BIN[$name]:-}" ] && continue
    NAMES+=("$name")
    CMD_BIN["$name"]="$f"
    CMD_SUMMARY["$name"]="${summary_l10n:-$summary}"
    CMD_ARGS["$name"]="$args"
    CMD_HIDDEN["$name"]="$hidden"
    if [ -n "$requires" ] && ! feature_available "$requires"; then
      CMD_HIDDEN["$name"]="true"
    fi
  done
  # Stable order, whatever order the directory is read in.
  if [ "${#NAMES[@]}" -gt 0 ]; then
    mapfile -t NAMES < <(printf '%s\n' "${NAMES[@]}" | sort)
  fi
}

visible_names() {
  local n
  for n in "${NAMES[@]}"; do
    [ "${CMD_HIDDEN[$n]}" = "true" ] || printf '%s\n' "$n"
  done
}

# printf "%-10s" counts bytes: an accented summary, or a multi-byte character in
# the arguments, would shift the columns. We pad by hand instead, on ${#s},
# which does count characters.
pad() {
  local s="$1" n=$(( $2 - ${#1} ))
  [ "$n" -lt 0 ] && n=0
  printf '%s%*s' "$s" "$n" ''
}

# One table row: name, arguments, summary.
print_table() {
  local n
  while IFS= read -r n; do
    printf '  \033[36m%s\033[0m %s %s\n' \
      "$(pad "$n" 12)" "$(pad "${CMD_ARGS[$n]}" 26)" "${CMD_SUMMARY[$n]}"
  done < <(visible_names)
}

usage() {
  cat <<'EOT'
devbox: the commands of the dev box.

Usage:
  devbox                 selection menu
  devbox <cmd> [args...] run a command
  devbox <cmd> --help    help for that command
  devbox commands        bare list of the commands

EOT
  printf '\033[1mCommands\033[0m\n'
  print_table
}

unknown() {
  echo "devbox: unknown command '$1'" >&2
  echo >&2
  print_table >&2
  exit 2
}

# Help for a command: the header first (always there), then the binary's own
# help when it handles one. The test stays a read of the source, nothing is run
# blindly.
cmd_help() {
  local name="$1" bin="${CMD_BIN[$1]}"
  printf '\033[1m%s\033[0m: %s\n' "$name" "${CMD_SUMMARY[$name]}"
  printf 'Usage: devbox %s %s\n' "$name" "${CMD_ARGS[$name]}"
  if head -n 200 "$bin" 2>/dev/null | grep -qa -- '--help'; then
    echo
    "$bin" --help || true
  fi
}

menu() {
  local lines=() n chosen
  while IFS= read -r n; do
    lines+=("$(printf '%s %s' "$(pad "$n" 12)" "${CMD_SUMMARY[$n]}")")
  done < <(visible_names)

  if [ "${#lines[@]}" -eq 0 ]; then
    echo "devbox: no command found in $BIN_DIR" >&2
    exit 1
  fi
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "devbox: no terminal, the menu needs a tty." >&2
    echo "Give a command: devbox <cmd>." >&2
    echo >&2
    print_table >&2
    exit 2
  fi
  command -v gum >/dev/null 2>&1 || {
    echo "devbox: gum is missing, give a command: devbox <cmd>." >&2
    exit 1
  }

  chosen="$(printf '%s\n' "${lines[@]}" \
    | gum choose --height 15 --header "Box commands")" || true
  [ -n "$chosen" ] || exit 0
  chosen="${chosen%% *}"
  exec "${CMD_BIN[$chosen]}"
}

discover
[ "${#NAMES[@]}" -gt 0 ] || { echo "devbox: no command found in $BIN_DIR" >&2; exit 1; }

case "${1:-}" in
  "")            menu ;;
  -h|--help|help) usage; exit 0 ;;
  commands)      visible_names; exit 0 ;;
  -*)            unknown "$1" ;;
esac

name="$1"; shift
[ -n "${CMD_BIN[$name]:-}" ] || unknown "$name"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cmd_help "$name"
  exit 0
fi

exec "${CMD_BIN[$name]}" "$@"
