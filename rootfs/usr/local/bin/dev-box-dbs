#!/usr/bin/env bash
# devbox:name=dbs
# devbox:summary=Start a development database (podman)
# devbox:args=[db...|--list|--remove]
#
# Development databases, in the box's rootless podman containers, on the model
# of `omarchy-install-docker-dbs` on the host: same images, same development
# options (no password, or a password you already know).
#
#   dev-box-dbs                  menu: start, stop, start again or remove, then a selection
#   dev-box-dbs postgres redis   start these databases
#   dev-box-dbs --list           the databases, image, port and state
#   dev-box-dbs --start <db...>  start an existing container again
#   dev-box-dbs --stop <db...>   stop a container, erasing nothing
#   dev-box-dbs --remove <db...> drop the container, keep the volume
#   dev-box-dbs --remove --purge <db...>   drop the data too
#
# Ports are published on 127.0.0.1: reachable from the box, not from outside
# (an SSH tunnel for that, see docs/databases.md). The data lives in a podman volume
# named "devbox-<db>", which survives --remove.
#
# Nothing restarts on its own: after a restart of the box, bring the database
# back with `devbox dbs <db>` or `devbox dbs --start <db>`.

# The env_* functions are called indirectly, through "env_${name}".
# shellcheck disable=SC2329
set -euo pipefail

# The /usr/local/bin/podman wrapper comes first on the PATH, and it brings
# nothing here: the enable message is already handled below.
PODMAN="/usr/bin/podman"
SOCK="/run/user/$(id -u)/podman/podman.sock"

# <name>|<image>|<port>|<data path inside the container>|<description>
DBS=(
  "mysql|mysql:8.4|3306|/var/lib/mysql|MySQL 8.4, root with an empty password"
  "postgres|postgres:18|5432|/var/lib/postgresql|PostgreSQL 18, user postgres, trust"
  "mariadb|mariadb:11.8|3306|/var/lib/mysql|MariaDB 11.8, root with an empty password"
  "redis|redis:7|6379|/data|Redis 7, no password"
  "mongodb|mongo:noble|27017|/data/db|MongoDB, admin / admin123"
  "mssql|mcr.microsoft.com/mssql/server:2022-CU12-ubuntu-22.04|1433|/var/opt/mssql|SQL Server 2022, sa / @dmin123 (amd64 only)"
)

log() { printf '\033[1m[dev-box-dbs]\033[0m %s\n' "$*"; }
err() { echo "dev-box-dbs: $*" >&2; }

db_names() {
  local d
  for d in "${DBS[@]}"; do printf '%s\n' "${d%%|*}"; done
}

# db_field <name> <field number>: image (2), port (3), path (4), description (5)
db_field() {
  local d
  for d in "${DBS[@]}"; do
    [ "${d%%|*}" = "$1" ] && {
      printf '%s' "$(echo "$d" | cut -d'|' -f"$2")"
      return 0
    }
  done
  return 1
}

# --- Podman has to be active --------------------------------------------------
# Same message as the dev-box-podman wrapper: without a socket we start nothing,
# rather than create half of the containers and fail on the rest.
require_podman() {
  [ -S "$SOCK" ] && return 0
  local state="disabled"
  [ -r /etc/devbox/podman.state ] && state="$(cat /etc/devbox/podman.state)"
  {
    echo "dev-box-dbs: podman is not active on this box, no database started."
    if [ "$state" != "enabled" ]; then
      echo "  Rootless podman is off (PODMAN_ENABLE missing or false in .env)."
      echo "  To turn it on, on the host:"
      echo "    1. uncomment the podman block of compose.override.example.yaml"
      echo "       (/dev/fuse + security_opt) in compose.override.yaml;"
      echo "    2. PODMAN_ENABLE=true in .env;"
      echo "    3. restart the container."
      echo "  That block loosens the isolation of the box: see docs/containers.md"
      echo "  in the dev-box repository."
    else
      echo "  PODMAN_ENABLE=true but the socket $SOCK is missing:"
      echo "  the service did not start. See ~/.cache/dev-box-podman.log and check"
      echo "  that compose.override.yaml really has the podman block (/dev/fuse, security_opt)."
    fi
  } >&2
  exit 1
}

# --- State of the containers --------------------------------------------------

container_of() { printf 'devbox-%s' "$1"; }
volume_of() { printf 'devbox-%s' "$1"; }

container_exists() { "$PODMAN" container exists "$(container_of "$1")" 2>/dev/null; }

container_running() {
  [ "$("$PODMAN" ps --filter "name=^$(container_of "$1")\$" --format '{{.Names}}' 2>/dev/null)" \
    = "$(container_of "$1")" ]
}

container_status() {
  local s
  s="$("$PODMAN" ps -a --filter "name=^$(container_of "$1")\$" --format '{{.Status}}' 2>/dev/null | head -n1)"
  [ -n "$s" ] && printf '%s' "$s" || printf 'absent'
}

# --- The options of each image, taken from omarchy ----------------------------

env_mysql() { printf '%s\n' -e "MYSQL_ROOT_PASSWORD=" -e "MYSQL_ALLOW_EMPTY_PASSWORD=true"; }
env_mariadb() { printf '%s\n' -e "MARIADB_ROOT_PASSWORD=" -e "MARIADB_ALLOW_EMPTY_ROOT_PASSWORD=true"; }
env_postgres() { printf '%s\n' -e "POSTGRES_HOST_AUTH_METHOD=trust"; }
env_redis() { :; }
env_mongodb() { printf '%s\n' -e "MONGO_INITDB_ROOT_USERNAME=admin" -e "MONGO_INITDB_ROOT_PASSWORD=admin123"; }
env_mssql() { printf '%s\n' -e "MSSQL_PID=Developer" -e "ACCEPT_EULA=Y" -e "MSSQL_SA_PASSWORD=@dmin123"; }

# --- Actions ------------------------------------------------------------------

show_list() {
  require_podman
  local d name image port
  printf '\033[1mDatabases\033[0m (devbox dbs <name>...)\n\n'
  printf '  \033[1m%-9s %-54s %-6s %s\033[0m\n' "name" "image" "port" "state"
  for d in "${DBS[@]}"; do
    name="${d%%|*}"
    image="$(echo "$d" | cut -d'|' -f2)"
    port="$(echo "$d" | cut -d'|' -f3)"
    printf '  \033[36m%-9s\033[0m %-54s %-6s %s\n' \
      "$name" "$image" "$port" "$(container_status "$name")"
  done
  printf '\nPorts published on 127.0.0.1, containers named "devbox-<name>",\n'
  printf 'data in the podman volume "devbox-<name>".\n'
}

show_help() { sed -n '6,24p' "$0" | sed 's/^# \?//'; }

# Only one database can hold a port, and mysql and mariadb are both on 3306.
# Better to say so than to let podman fail on "address already in use".
port_taken_by() {
  local name="$1" port="$2" d other
  for d in "${DBS[@]}"; do
    other="${d%%|*}"
    [ "$other" = "$name" ] && continue
    [ "$(echo "$d" | cut -d'|' -f3)" = "$port" ] || continue
    container_running "$other" && {
      printf '%s' "$other"
      return 0
    }
  done
  return 1
}

start_db() {
  local name="$1" image port datadir busy args
  image="$(db_field "$name" 2)"
  port="$(db_field "$name" 3)"
  datadir="$(db_field "$name" 4)"

  # mcr.microsoft.com/mssql/server only publishes amd64 images.
  if [ "$name" = "mssql" ] && [ "$(uname -m)" = "aarch64" ]; then
    err "mssql has no arm64 image (mcr.microsoft.com/mssql/server is amd64 only)."
    err "On this machine, take postgres, mysql or mariadb."
    return 1
  fi

  if container_running "$name"; then
    log "$name: already running on 127.0.0.1:$port ($(container_of "$name"))."
    return 0
  fi

  if busy="$(port_taken_by "$name" "$port")"; then
    err "$name and $busy share port $port, and $busy is already running."
    err "Stop the other one first: devbox dbs --stop $busy"
    return 1
  fi

  if container_exists "$name"; then
    log "$name: the container already exists, starting it again (data kept)."
    "$PODMAN" start "$(container_of "$name")" >/dev/null
  else
    log "$name: $(db_field "$name" 5)"
    mapfile -t args < <("env_${name}")
    "$PODMAN" run -d \
      --name "$(container_of "$name")" \
      -p "127.0.0.1:${port}:${port}" \
      -v "$(volume_of "$name"):${datadir}" \
      "${args[@]}" "$image" >/dev/null
  fi
  log "$name: ready on 127.0.0.1:$port"
}

stop_db() {
  local name="$1"
  container_exists "$name" || {
    err "$name: no container $(container_of "$name")."
    return 1
  }
  "$PODMAN" stop "$(container_of "$name")" >/dev/null
  log "$name: stopped (data kept)."
}

restart_db() {
  local name="$1" port busy
  port="$(db_field "$name" 3)"
  container_exists "$name" || {
    err "$name: no container $(container_of "$name"), create it with: devbox dbs $name"
    return 1
  }
  container_running "$name" && {
    log "$name: already running."
    return 0
  }
  if busy="$(port_taken_by "$name" "$port")"; then
    err "$name and $busy share port $port, and $busy is already running."
    err "Stop the other one first: devbox dbs --stop $busy"
    return 1
  fi
  "$PODMAN" start "$(container_of "$name")" >/dev/null
  log "$name: started again on 127.0.0.1:$port"
}

confirm() {
  if command -v gum >/dev/null 2>&1 && [ -t 0 ] && [ -t 1 ]; then
    gum confirm "$1"
    return $?
  fi
  err "cannot ask for confirmation without a terminal (gum): $1"
  return 1
}

remove_db() {
  local name="$1" vol
  vol="$(volume_of "$name")"
  if container_exists "$name"; then
    "$PODMAN" rm -f "$(container_of "$name")" >/dev/null
    log "$name: container removed."
  else
    log "$name: no container to remove."
  fi
  if [ "$PURGE" = "true" ]; then
    if ! "$PODMAN" volume exists "$vol" 2>/dev/null; then
      log "$name: no volume $vol."
      return 0
    fi
    confirm "Delete the data of $name for good (volume $vol)?" || {
      log "$name: volume kept."
      return 0
    }
    "$PODMAN" volume rm "$vol" >/dev/null
    log "$name: volume $vol deleted, data lost."
  else
    log "$name: volume $vol kept, 'devbox dbs $name' will come back on it."
  fi
}

# --- Arguments ----------------------------------------------------------------

ACTION="start"
PURGE="false"
SELECTED=()

while [ "$#" -gt 0 ]; do
  case "$1" in
  --list | -l)
    show_list
    exit 0
    ;;
  -h | --help)
    show_help
    exit 0
    ;;
  --stop)
    ACTION="stop"
    shift
    ;;
  --start)
    ACTION="restart"
    shift
    ;;
  --remove)
    ACTION="remove"
    shift
    ;;
  --purge)
    PURGE="true"
    shift
    ;;
  -*)
    err "unknown option '$1'"
    exit 2
    ;;
  *)
    SELECTED+=("$1")
    shift
    ;;
  esac
done

if [ "$PURGE" = "true" ] && [ "$ACTION" != "remove" ]; then
  err "--purge only goes with --remove."
  exit 2
fi

require_podman

# Without arguments: the menu. With --stop, --start or --remove and no name,
# the menu only offers the databases that have a container; with nothing at
# all it first asks what to do. Scripts must give the names.
if [ "${#SELECTED[@]}" -eq 0 ]; then
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    err "no terminal, give the databases as arguments."
    err "Available databases: $(db_names | tr '\n' ' ')"
    exit 2
  fi
  command -v gum >/dev/null 2>&1 || {
    err "gum is missing, give the databases as arguments."
    exit 1
  }
  if [ "$ACTION" = "start" ] && [ "$PURGE" = "false" ]; then
    verb="$(printf '%s\n' \
        "Start        a database (a new container, or an existing one)" \
        "Stop         a running container, erasing nothing" \
        "Start again  an existing container" \
        "Remove       a container, the data stays in its volume" \
        "Purge        a container and its data, for good" \
      | gum choose --height 7 --header "devbox dbs: what do you want to do?")" || true
    case "$verb" in
      Start\ again*) ACTION="restart" ;;
      Start*)  ACTION="start" ;;
      Stop*)   ACTION="stop" ;;
      Remove*) ACTION="remove" ;;
      Purge*)  ACTION="remove"; PURGE="true" ;;
      *) echo "Nothing selected."; exit 0 ;;
    esac
  fi
  menu=()
  for d in "${DBS[@]}"; do
    name="${d%%|*}"
    # Only what exists can be stopped, started again or removed
    if [ "$ACTION" != "start" ] && ! container_exists "$name"; then continue; fi
    menu+=("$(printf '%-9s %s (%s)' "$name" "$(echo "$d" | cut -d'|' -f5)" "$(container_status "$name")")")
  done
  if [ "${#menu[@]}" -eq 0 ]; then
    echo "No database container, nothing to ${ACTION/restart/start again}."
    exit 0
  fi
  chosen="$(printf '%s\n' "${menu[@]}" |
    gum choose --no-limit --height 10 \
      --header "Databases to ${ACTION/restart/start again} (x to tick, enter to confirm)")" || true
  [ -n "$chosen" ] || {
    echo "Nothing selected."
    exit 0
  }
  while IFS= read -r line; do
    [ -n "$line" ] && SELECTED+=("${line%% *}")
  done <<<"$chosen"
fi

# The names are validated before the first action: better to refuse right away
# than to act halfway.
for name in "${SELECTED[@]}"; do
  db_field "$name" 1 >/dev/null || {
    err "unknown database '$name'"
    err "Available databases: $(db_names | tr '\n' ' ')"
    exit 1
  }
done

rc=0
for name in "${SELECTED[@]}"; do
  case "$ACTION" in
  start) start_db "$name" || rc=1 ;;
  restart) restart_db "$name" || rc=1 ;;
  stop) stop_db "$name" || rc=1 ;;
  remove) remove_db "$name" || rc=1 ;;
  esac
done
exit "$rc"
