#!/usr/bin/env bash
# devbox:name=status
# devbox:summary=State of the box: access, podman, tools, dev environments, updates
# devbox:summary.fr=État de la box : accès, podman, outils, environnements de dev, mises à jour
# devbox:args=
#
# A one-page summary of what the box is doing right now. Read only: nothing is
# installed, nothing is changed, and there is no slow network call.
set -euo pipefail

title() { printf '\n\033[1m%s\033[0m\n' "$*"; }
# printf "%-12s" counts bytes, so a multi-byte label would shift the column.
# We pad on ${#1}, which does count characters.
item() {
  local n=$(( 12 - ${#1} ))
  [ "$n" -lt 0 ] && n=0
  printf '  %s%*s %s\n' "$1" "$n" '' "$2"
}

# --- Image: what it was built from, /etc/devbox/release through the lib ------
title "Image"
if [ -r /etc/devbox/release ]; then
  # shellcheck source=/dev/null
  . /usr/share/devbox/lib/release.sh
  if [ "$DEVBOX_SOURCE" = "release" ]; then
    item "version" "$(devbox_version), published image (pull it and restart the container on the host)"
    item "image" "$(devbox_image_ref)"
    # An arm64 box on the amd64 image, or on the multi-arch latest of before
    # the split: DEVBOX_IMAGE has to change on the host before the next pull.
    if advice="$(devbox_image_arch_advice)"; then
      printf '  \033[33m%s\033[0m\n' "$advice"
    fi
  else
    item "version" "$(devbox_version), built locally (rebuild the container on the host)"
  fi
  item "commit" "$DEVBOX_COMMIT"
  item "repo" "${DEVBOX_REPO:-unknown} ($DEVBOX_BRANCH)"
else
  item "commit" "unknown (/etc/devbox/release is missing)"
fi
# `hostname` is not installed in the image: the kernel gives it just as well.
item "host" "$(cat /proc/sys/kernel/hostname)"

# --- Access: Tailscale, or the fallback sshd ----------------------------------
title "Access"
if [ "${TS_DISABLE:-false}" = "true" ]; then
  if pgrep -x sshd >/dev/null 2>&1; then
    item "sshd" "listening (TS_DISABLE=true)"
  else
    item "sshd" "stopped (SSH_AUTHORIZED_KEYS empty?)"
  fi
else
  if ts="$(timeout 10 tailscale status --peers=false 2>&1)"; then
    printf '%s\n' "$ts" | sed 's/^/  /'
  else
    item "tailscale" "unavailable: $(printf '%s' "$ts" | head -n 1)"
  fi
fi

# --- Rootless podman: opt-in, state written by the entrypoint -----------------
title "Podman"
state="disabled"
[ -r /etc/devbox/podman.state ] && state="$(cat /etc/devbox/podman.state)"
sock="/run/user/$(id -u)/podman/podman.sock"
item "state" "$state"
if [ -S "$sock" ]; then
  item "socket" "$sock"
else
  item "socket" "missing ($sock)"
fi

# --- mise tools: what is actually active in this shell ------------------------
title "mise tools"
if command -v mise >/dev/null 2>&1; then
  # --current: the versions active here, not everything sitting in the cache.
  if tools="$(mise ls --current 2>/dev/null)" && [ -n "$tools" ]; then
    printf '%s\n' "$tools" | awk 'NF >= 2 { printf "  %-22s %s\n", $1, $2 }'
  else
    item "none" "nothing installed yet"
  fi
  item "config" "~/.config/mise/config.toml"
else
  item "mise" "not on the PATH"
fi

# --- pacman packages kept by dev-box-pkg (reinstalled after a rebuild) --------
pkg_list="$HOME/.config/dev-box/packages"
if [ -s "$pkg_list" ]; then
  pkg_total=0; pkg_missing=0
  while IFS= read -r p; do
    case "$p" in ''|'#'*) continue ;; esac
    pkg_total=$((pkg_total + 1))
    pacman -Q "$p" >/dev/null 2>&1 || pkg_missing=$((pkg_missing + 1))
  done < "$pkg_list"
  item "packages" "persistent: $pkg_total ($pkg_missing missing)"
fi

# --- DEV_ENVS: the environments .env asks for at start ------------------------
# DEV_ENVS is not in the environment of an SSH session: the entrypoint writes
# it to /etc/devbox/env, read here the way TS_DISABLE is read by dev-box-motd.
dev_envs="${DEV_ENVS:-}"
if [ -z "$dev_envs" ] && [ -r /etc/devbox/env ]; then
  dev_envs="$(sed -n 's/^export DEV_ENVS=//p' /etc/devbox/env | tail -n 1)"
  # %q of an empty value is '' and a value with spaces is quoted: undo that.
  dev_envs="${dev_envs#\'}"; dev_envs="${dev_envs%\'}"; dev_envs="${dev_envs//\\ / }"
fi
if [ -n "$dev_envs" ]; then
  title "Dev environments"
  installed="$(dev-box-dev-env --installed 2>/dev/null || true)"
  unsupported="$(dev-box-dev-env --unsupported 2>/dev/null || true)"
  missing=""
  skipped=""
  for e in $dev_envs; do
    if printf '%s\n' "$installed" | grep -qx "$e"; then continue; fi
    if printf '%s\n' "$unsupported" | grep -qx "$e"; then
      skipped="$skipped $e"
    else
      missing="$missing $e"
    fi
  done
  item "DEV_ENVS" "$dev_envs"
  [ -z "$skipped" ] || item "skipped" "${skipped# } (not available on $(uname -m))"
  if [ -n "$missing" ]; then
    item "missing" "${missing# } (installed at start, see ~/.cache/dev-box/dev-envs.log)"
  else
    item "state" "all installed"
  fi
  flag="$HOME/.cache/dev-box/dev-envs"
  [ -s "$flag" ] && item "last start" "$(head -n 1 "$flag")"
fi

# --- Update flag, written by dev-box-check-updates ----------------------------
title "Updates"
flag="$HOME/.cache/dev-box/updates"
if [ -s "$flag" ]; then
  sed 's/^/  /' "$flag"
  printf '  \033[2mdevbox update\033[0m\n'
else
  item "none" "up to date at the last check (devbox check to run it again)"
  item "image" "devbox check --image says whether it is the latest"
fi
echo
