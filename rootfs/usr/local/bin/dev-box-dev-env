#!/usr/bin/env bash
# devbox:name=dev-env
# devbox:summary=Install or remove a dev environment (node, go, python, ...)
# devbox:args=[env...|--remove env...|--list|--info env]
#
# Installs or removes development environments in the home, through mise
# only: no pacman package, no `curl | sh`. Everything it lays down is therefore
# declared in ~/.config/mise/config.toml and survives a rebuild. Two
# exceptions, both persistent all the same: php comes from the image, and
# browser goes through `devbox pkg`, whose list is reinstalled at start.
#
#   dev-box-dev-env                   interactive: install or remove, then a menu
#   dev-box-dev-env node go           install these environments right away
#   dev-box-dev-env --remove node go  remove these environments
#   dev-box-dev-env --list            the environments, with what is installed
#   dev-box-dev-env --info node       what an environment installs and leaves
#   dev-box-dev-env --if-missing go   install only what is not installed yet
#   dev-box-dev-env --installed       the installed environments, one per line
#   dev-box-dev-env --unsupported     the ones this machine cannot take, one per line
#
# One environment is one script, found on its own: /usr/share/devbox/dev-envs
# for the image, ~/.config/dev-box/dev-envs for your own (same name: yours
# wins). The format is at the top of /usr/share/devbox/lib/dev-env.sh.
#
# --if-missing is what the entrypoint runs at start with DEV_ENVS from .env,
# in the background: an environment already there is skipped, and an unknown
# name refuses the whole list before anything is installed. An environment
# listed in DEV_ENVS cannot be removed: the next start would put it back.
#
# Running it twice breaks nothing: `mise use -g` rewrites the same config line,
# `mise unuse -g` does nothing on a tool that is already gone. A removal takes
# the tool out of the config and prunes the versions nothing else needs; it
# never touches project data (~/go, ~/.cargo, ~/.mix, ~/.config/composer, ...).
set -euo pipefail

# shellcheck source=../../share/devbox/lib/dev-env.sh
. /usr/share/devbox/lib/dev-env.sh

# DEV_ENVS is not in the environment of an SSH session: the entrypoint writes
# it to /etc/devbox/env with %q, read here the way dev-box-status reads it.
dev_envs_from_env() {
  local v="${DEV_ENVS:-}"
  if [ -z "$v" ] && [ -r /etc/devbox/env ]; then
    v="$(sed -n 's/^export DEV_ENVS=//p' /etc/devbox/env | tail -n 1)"
    v="${v#\'}"; v="${v%\'}"; v="${v//\\ / }"
  fi
  printf '%s' "$v"
}
DEV_ENVS_LIST="$(dev_envs_from_env)"

# Listed in DEV_ENVS: the start reinstalls it, so removing it is refused.
pinned() {
  local e
  for e in $DEV_ENVS_LIST; do [ "$e" = "$1" ] && return 0; done
  return 1
}

dev_env_load

available() { printf '%s ' "${DEV_ENV_NAMES[@]}"; }

# --- Installed state and descriptions ----------------------------------------

# SUMMARY_INSTALLED[name], SUMMARY_SUPPORTED[name] (1 or 0) and
# SUMMARY_DESC[name], read once for the list and the menu through
# dev_env_summaries, from a file when the menu started it in the background.
# A script that fails to load is shown, marked broken.
declare -A SUMMARY_INSTALLED=() SUMMARY_SUPPORTED=() SUMMARY_DESC=()
load_summaries() {
  local name inst sup desc
  for name in "${DEV_ENV_NAMES[@]}"; do
    SUMMARY_INSTALLED[$name]=0
    SUMMARY_SUPPORTED[$name]=1
    SUMMARY_DESC[$name]="(broken script, see devbox dev-env --info $name)"
  done
  while IFS=$'\t' read -r name inst sup desc; do
    [ -n "${SUMMARY_DESC[$name]:-}" ] || continue
    SUMMARY_INSTALLED[$name]="$inst"
    SUMMARY_SUPPORTED[$name]="$sup"
    SUMMARY_DESC[$name]="$desc"
  done < <(if [ -n "${1:-}" ]; then cat "$1"; else dev_env_summaries; fi)
}

# The widest name, for the columns.
name_width() {
  local name w=9
  for name in "${DEV_ENV_NAMES[@]}"; do
    [ "${#name}" -gt "$w" ] && w="${#name}"
  done
  printf '%s' "$w"
}

# Where a script comes from, for --list and --info.
origin() {
  case "${DEV_ENV_FILES[$1]}" in
  "$DEV_ENV_USER_DIR"/*)
    if [ -f "$DEV_ENV_SYSTEM_DIR/$1.sh" ]; then echo "yours, over the image's"; else echo "yours"; fi
    ;;
  *) echo "image" ;;
  esac
}

show_list() {
  local name mark note w hidden=""
  load_summaries
  w="$(name_width)"
  printf '\033[1mDev environments\033[0m (devbox dev-env <name>..., devbox dev-env --remove <name>...)\n\n'
  for name in "${DEV_ENV_NAMES[@]}"; do
    if [ "${SUMMARY_SUPPORTED[$name]}" = 0 ]; then
      hidden="$hidden $name"
      continue
    fi
    mark=" "
    [ "${SUMMARY_INSTALLED[$name]}" = 1 ] && mark="*"
    note=""
    [ "$(origin "$name")" = image ] || note=" \033[2m($(origin "$name"))\033[0m"
    printf "  \033[32m%s\033[0m \033[36m%-${w}s\033[0m %s$note\n" "$mark" "$name" "${SUMMARY_DESC[$name]}"
  done
  printf '\n* installed. Without arguments: a menu, install or remove. The details: devbox dev-env --info <name>.\n'
  [ -z "$hidden" ] || printf 'Not available on this machine (%s):%s (--info says why).\n' "$(uname -m)" "$hidden"
  printf 'Your own environments go in ~/.config/dev-box/dev-envs/<name>.sh (format: /usr/share/devbox/lib/dev-env.sh).\n'
}

show_info() {
  local name="$1" text state file
  dev_env_exists "$name" || {
    err "unknown environment '$name'"
    err "Available environments: $(available)"
    exit 1
  }
  text="$(dev_env_call "$name" details)" || {
    err "${DEV_ENV_FILES[$name]} failed to load, see the error above."
    exit 1
  }
  if dev_env_call "$name" is_installed >/dev/null 2>&1; then state="installed"; else state="not installed"; fi
  pinned "$name" && state="$state, kept by DEV_ENVS"
  printf '\033[1m%s\033[0m: %s\n' "$name" "${text%%$'\n'*}"
  file="${DEV_ENV_FILES[$name]}"
  printf '  %s, %s\n' "$state" "${file/#"$HOME"/\~} ($(origin "$name"))"
  local why
  if why="$(dev_env_unsupported "$name")"; then
    printf '  \033[33mnot available on this machine (%s)\033[0m: %s\n' "$(uname -m)" "$why"
  fi
  if [[ "$text" == *$'\n'* ]]; then
    text="${text#*$'\n'}"
    # The blank line between the two parts is printed once, whatever the script put.
    text="$(printf '%s\n' "$text" | sed '/./,$!d')"
    [ -n "$text" ] && printf '\n%s\n' "$text"
  fi
}

run_env() {
  local action="$1" name="$2" desc
  desc="$(dev_env_call "$name" details)" || return 1
  log "$name: ${desc%%$'\n'*}"
  dev_env_call "$name" "$action"
}

# --- Arguments ---------------------------------------------------------------

ACTION="install"
IF_MISSING=false
SELECTED=()
while [ $# -gt 0 ]; do
  case "$1" in
  --list | -l)
    show_list
    exit 0
    ;;
  --info)
    [ $# -ge 2 ] || {
      err "--info needs an environment name"
      exit 2
    }
    show_info "$2"
    exit 0
    ;;
  --installed)
    dev_env_summaries | awk -F'\t' '$2 == 1 { print $1 }'
    exit 0
    ;;
  --unsupported)
    dev_env_summaries | awk -F'\t' '$3 == 0 { print $1 }'
    exit 0
    ;;
  --if-missing)
    IF_MISSING=true
    shift
    ;;
  -h | --help)
    sed -n '6,33p' "$0" | sed 's/^# \?//'
    exit 0
    ;;
  --remove)
    ACTION="uninstall"
    shift
    ;;
  -*)
    err "unknown option '$1'"
    exit 2
    ;;
  *)
    SELECTED+=("$1")
    shift
    ;;
  esac
done

# --- Interactive menu --------------------------------------------------------

# Two steps: install or remove, then the environments. The remove menu only
# offers what is installed; the install menu marks it.
menu() {
  local mode name mark menu=() chosen line w summaries pid
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    err "no terminal, give the environments as arguments."
    err "Available environments: $(available)"
    exit 2
  fi
  command -v gum >/dev/null 2>&1 || {
    err "gum is missing, give the environments as arguments."
    exit 1
  }

  # The environments are read while the first question is on screen.
  summaries="$(mktemp)"
  # shellcheck disable=SC2064
  trap "rm -f '$summaries'" EXIT
  dev_env_summaries > "$summaries" &
  pid=$!

  if [ "$ACTION" = "uninstall" ]; then
    mode="Remove"
  else
    mode="$(gum choose --header "devbox dev-env: what do you want to do?" \
      "Install environments" "Remove environments")" || true
    case "$mode" in
    Install*)
      mode="Install"
      ACTION="install"
      ;;
    Remove*)
      mode="Remove"
      ACTION="uninstall"
      ;;
    *)
      echo "Nothing selected."
      exit 0
      ;;
    esac
  fi

  wait "$pid" || true
  load_summaries "$summaries"
  w="$(name_width)"
  for name in "${DEV_ENV_NAMES[@]}"; do
    # Not for this machine: neither installable nor, therefore, installed.
    [ "${SUMMARY_SUPPORTED[$name]}" = 1 ] || continue
    if [ "${SUMMARY_INSTALLED[$name]}" = 1 ]; then mark=" (installed)"; else mark=""; fi
    if [ "$ACTION" = "uninstall" ]; then
      [ -n "$mark" ] || continue
      # Pinned by DEV_ENVS: not on offer, the start would put it back
      pinned "$name" && continue
      mark=""
    fi
    menu+=("$(printf "%-${w}s %s%s" "$name" "${SUMMARY_DESC[$name]}" "$mark")")
  done
  if [ "${#menu[@]}" -eq 0 ]; then
    echo "Nothing installed by devbox dev-env, nothing to remove."
    [ -n "$DEV_ENVS_LIST" ] && echo "DEV_ENVS keeps: $DEV_ENVS_LIST (set in .env on the host)."
    exit 0
  fi

  chosen="$(printf '%s\n' "${menu[@]}" |
    gum choose --no-limit --height 18 \
      --header "Environments to ${mode,,} (x to tick, enter to confirm)")" || true
  [ -n "$chosen" ] || {
    echo "Nothing selected."
    exit 0
  }
  while IFS= read -r line; do
    [ -n "$line" ] && SELECTED+=("${line%% *}")
  done <<<"$chosen"
}

[ "${#SELECTED[@]}" -gt 0 ] || menu

# The names are validated before the first action: better to refuse right away
# than to fail in the middle of a list. An environment this machine cannot
# take is refused, except by --if-missing, which skips it: the same DEV_ENVS
# may serve an amd64 box and an arm64 one.
kept=()
for name in "${SELECTED[@]}"; do
  dev_env_exists "$name" || {
    err "unknown environment '$name'"
    err "Available environments: $(available)"
    exit 1
  }
  if [ "$ACTION" = "uninstall" ] && pinned "$name"; then
    err "'$name' is listed in DEV_ENVS ($DEV_ENVS_LIST): the next start would install it again."
    err "Take it out of DEV_ENVS in .env on the host, run just up, then remove it."
    exit 1
  fi
  if [ "$ACTION" = "install" ] && why="$(dev_env_unsupported "$name")"; then
    if [ "$IF_MISSING" = "true" ]; then
      log "$name: not available on this machine ($why), skipped"
      continue
    fi
    err "'$name' is not available on this machine: $why"
    exit 1
  fi
  kept+=("$name")
done
if [ "${#kept[@]}" -eq 0 ]; then
  log "Nothing to install."
  exit 0
fi
SELECTED=("${kept[@]}")

# --if-missing: what is already there is left alone, the rest is installed.
if [ "$IF_MISSING" = "true" ]; then
  [ "$ACTION" = "install" ] || {
    err "--if-missing only makes sense for an install."
    exit 2
  }
  todo=()
  for name in "${SELECTED[@]}"; do
    if dev_env_call "$name" is_installed >/dev/null 2>&1; then
      log "$name: already installed, skipped"
    else
      todo+=("$name")
    fi
  done
  if [ "${#todo[@]}" -eq 0 ]; then
    log "Nothing to install."
    exit 0
  fi
  SELECTED=("${todo[@]}")
fi

rc=0
for name in "${SELECTED[@]}"; do
  run_env "$ACTION" "$name" || {
    log "⚠ $name failed"
    rc=1
  }
done

echo
if [ "$ACTION" = "uninstall" ]; then
  log "Removed from ~/.config/mise/config.toml, unused versions pruned."
  log "Project data was left in place. Reinstall any time: devbox dev-env <name>."
else
  log "Tools declared in ~/.config/mise/config.toml."
  log "Upgrade later: devbox update tools. Remove: devbox dev-env --remove <name>."
fi
exit "$rc"
