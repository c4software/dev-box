#!/usr/bin/env bash
# devbox:name=seed
# devbox:summary=Lay down the shipped config, overwriting nothing
# devbox:args=[--apply|--force|--check] [path]
# Lays down the config shipped by the image (agents, extensions, mise config)
# in the home, without ever overwriting a local change.
#
# A reference copy of what was laid down is kept in
# ~/.config/dev-box/seed/<path>. It is what tells a file that was never
# touched, which can be updated, from a file the user changed, which is
# reported and never overwritten.
#
# Usable by root (the entrypoint, with DEVBOX_HOME + chown 1000:1000) or by
# the user (`devbox update seed`, or `devbox seed`).
#
#   dev-box-seed                  apply the shipped config (on a terminal: a menu)
#   dev-box-seed --apply          apply, with no menu
#   dev-box-seed --force [path]   overwrite (everything, or the given path)
#   dev-box-seed --check          write nothing, list what is newly shipped
set -euo pipefail

# Table: <source in the image>:<path relative to the home>
SEEDS=(
  "/etc/devbox/claude/settings.json:.claude/settings.json"
  "/etc/devbox/claude/agents/pi.md:.claude/agents/pi.md"
  "/etc/devbox/claude/agents/omp.md:.claude/agents/omp.md"
  "/etc/devbox/llm-proxy.ts:.pi/agent/extensions/llm-proxy.ts"
  "/etc/devbox/llm-proxy.ts:.omp/agent/extensions/llm-proxy.ts"
  "/etc/devbox/mise-config.toml:.config/mise/config.toml"
)

FORCE=false
CHECK=false
APPLY=false
ONLY=""
while [ $# -gt 0 ]; do
  case "$1" in
    --force) FORCE=true; shift ;;
    --check) CHECK=true; shift ;;
    --apply) APPLY=true; shift ;;
    -h|--help) sed -n '5,19p' "$0" | sed 's/^# \?//'; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *)  ONLY="$1"; shift ;;
  esac
done

# Without arguments, on a terminal: apply, check or force as a gum menu. The
# entrypoint and dev-box-update never land here (no terminal, or --apply).
if ! $FORCE && ! $CHECK && ! $APPLY && [ -z "$ONLY" ] \
   && [ -t 0 ] && [ -t 1 ] && command -v gum >/dev/null 2>&1; then
  choice="$(printf '%s\n' \
      "apply   lay down what is missing, update what was never touched" \
      "check   write nothing, list what is newly shipped" \
      "force   overwrite one shipped file, or all of them" \
    | gum choose --height 5 --header "Shipped config")" || exit 0
  [ -n "$choice" ] || exit 0
  case "${choice%% *}" in
    check) CHECK=true ;;
    force)
      FORCE=true
      choice="$(
        { echo "everything"
          for s in "${SEEDS[@]}"; do echo "~/${s#*:}"; done; } \
        | gum choose --height 10 --header "Overwrite with the shipped version")" || exit 0
      [ -n "$choice" ] || exit 0
      [ "$choice" = "everything" ] || ONLY="$choice"
      ;;
  esac
fi

# Target home: the caller's, or DEVBOX_HOME when the entrypoint (root) calls it
TARGET_HOME="${DEVBOX_HOME:-$HOME}"
REF_DIR="$TARGET_HOME/.config/dev-box/seed"
# Root lays the files down as the box user (fixed UID/GID)
OWNER=""
[ "$(id -u)" = "0" ] && OWNER="1000:1000"

# shellcheck disable=SC2088  # the tilde is for display, not for the shell
log() { $CHECK || echo "[dev-box-seed] $*"; }

# ~/x, /home/dev/x, x all become x
normalize() {
  local p="$1"
  p="${p#"$TARGET_HOME"/}"
  p="${p#\~/}"
  p="${p#./}"
  printf '%s' "$p"
}
ONLY="$(normalize "$ONLY")"

# install_as <source> <destination>
# When root calls, every directory created has to end up owned by the user
# (`install -d -o` only handles the last component), otherwise
# ~/.config/dev-box would stay root's and the user could no longer write there.
install_as() {
  local dir sub
  dir="$(dirname "$2")"
  mkdir -p "$dir"
  if [ -n "$OWNER" ]; then
    sub="$dir"
    while [ "$sub" != "$TARGET_HOME" ] && [ "$sub" != "/" ]; do
      chown "$OWNER" "$sub"
      sub="$(dirname "$sub")"
    done
    install -m 644 -o "${OWNER%%:*}" -g "${OWNER##*:}" "$1" "$2"
  else
    install -m 644 "$1" "$2"
  fi
}

MATCHED=false
for entry in "${SEEDS[@]}"; do
  src="${entry%%:*}"
  rel="${entry#*:}"
  [ -n "$ONLY" ] && [ "$ONLY" != "$rel" ] && continue
  MATCHED=true
  [ -f "$src" ] || continue

  dst="$TARGET_HOME/$rel"
  ref="$REF_DIR/$rel"

  if $FORCE; then
    install_as "$src" "$dst"
    install_as "$src" "$ref"
    log "config replaced: ~/$rel"
    continue
  fi

  # 1. Nothing there: lay it down and record the reference
  if [ ! -e "$dst" ]; then
    if $CHECK; then continue; fi
    install_as "$src" "$dst"
    install_as "$src" "$ref"
    log "config laid down: ~/$rel"
    continue
  fi

  # 2. No reference (existing box): adopt the shipped version as the
  #    reference, without overwriting anything
  if [ ! -e "$ref" ]; then
    if $CHECK; then continue; fi
    install_as "$src" "$ref"
    cmp -s "$dst" "$src" || log "~/$rel differs from the shipped version (kept, reference adopted)"
    continue
  fi

  # Shipped version unchanged since it was laid down: nothing to do
  if cmp -s "$src" "$ref"; then
    continue
  fi

  if cmp -s "$dst" "$ref"; then
    # 3. Never changed locally: updated in place
    if $CHECK; then
      echo "shipped config updated: ~/$rel"
    else
      install_as "$src" "$dst"
      install_as "$src" "$ref"
      log "config updated: ~/$rel"
    fi
  else
    # 4. Changed locally: we report it, we do not overwrite
    if $CHECK; then
      echo "shipped config updated: ~/$rel (changed locally)"
    else
      log "~/$rel changed locally, a new shipped version is available (dev-box-seed --force ~/$rel)"
    fi
  fi
done

if [ -n "$ONLY" ] && ! $MATCHED; then
  echo "dev-box-seed: ~/$ONLY is not part of the shipped config" >&2
  exit 1
fi
