#!/usr/bin/env bash
# Stand-in for wl-copy in the box: there is no Wayland here, but the `copy`
# function of the dotarchy config (and anything else calling wl-copy) has to
# work. The text goes into the tmux buffer (paste it with prefix + ]) and, over
# OSC 52, into the clipboard of the terminal showing the session, SSH included.
# Usage: wl-copy [text...]  |  command | wl-copy
set -euo pipefail

if [ $# -gt 0 ]; then
  data="$*"
else
  data="$(cat)"
fi

# Inside tmux: load-buffer -w fills the buffer and relays OSC 52 to the
# terminal (tmux 3.2 or later, set-clipboard on external or on, the default).
if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
  printf '%s' "$data" | tmux load-buffer -w - 2>/dev/null && exit 0
fi

# Outside tmux: OSC 52 straight to the controlling terminal, when there is one
# (testing -w /dev/tty is not enough: without a terminal, the write fails).
if { printf '\033]52;c;%s\a' "$(printf '%s' "$data" | base64 -w0)" > /dev/tty; } 2>/dev/null; then
  exit 0
fi

echo "wl-copy: no tmux and no terminal, nothing to copy into" >&2
exit 1
