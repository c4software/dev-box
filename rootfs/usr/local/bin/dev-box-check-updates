#!/usr/bin/env bash
# devbox:name=check
# devbox:summary=Look for updates, install nothing
# devbox:args=
# Checks, without installing anything, what could be updated: dotfiles (HEAD of
# the clone against the remote branch), the dev-box image (commit baked in at
# build time against the remote branch), mise tools, config shipped by the image.
# Writes ~/.cache/dev-box/updates (one line per item) when something is
# available, and removes the file otherwise. It only downloads metadata and must
# never block: everything is bounded by a timeout and neutralised on failure.
set -euo pipefail

FLAG_DIR="$HOME/.cache/dev-box"
FLAG="$FLAG_DIR/updates"

[ -f /etc/devbox/dotarchy.env ] && . /etc/devbox/dotarchy.env
BRANCH="${DOTARCHY_BRANCH:-main}"
SRC="$HOME/.local/share/dotarchy"

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

# --- 1. Dotfiles: local HEAD against remote HEAD (git ls-remote, no object pulled) ---
if [ -d "$SRC/.git" ]; then
  local_head="$(git -C "$SRC" rev-parse HEAD 2>/dev/null || true)"
  remote_head="$(GIT_TERMINAL_PROMPT=0 timeout 30 \
      git -C "$SRC" ls-remote origin "$BRANCH" 2>/dev/null | awk 'NR==1{print $1}' || true)"
  if [ -n "$local_head" ] && [ -n "$remote_head" ] && [ "$local_head" != "$remote_head" ]; then
    echo "dotfiles: new version (${local_head:0:7} -> ${remote_head:0:7})" >> "$tmp"
  fi
fi

# --- 2. dev-box image: commit baked in at build time against the remote repo HEAD ---
if [ -r /etc/devbox/release ]; then
  DEVBOX_COMMIT=""; DEVBOX_REPO=""; DEVBOX_BRANCH="main"
  . /etc/devbox/release
  if [ -n "$DEVBOX_REPO" ] && [ "${DEVBOX_COMMIT:-unknown}" != "unknown" ]; then
    # ssh URL (git@github.com:x/y.git) becomes https: the box has no key for it
    repo_url="$DEVBOX_REPO"
    case "$repo_url" in
      git@*:*) repo_url="https://${repo_url#git@}"; repo_url="${repo_url/:/\/}" ;;
      ssh://git@*) repo_url="https://${repo_url#ssh://git@}" ;;
    esac
    # Private GitHub repo: GITHUB_TOKEN is the authentication, when it can read
    # the repo (otherwise the call fails and the check is simply skipped;
    # `just status` on the host makes the same comparison).
    auth=()
    if [ -n "${GITHUB_TOKEN:-}" ]; then
      auth=(-c "http.extraheader=Authorization: Bearer $GITHUB_TOKEN")
    fi
    image_remote="$(GIT_TERMINAL_PROMPT=0 timeout 30 \
        git "${auth[@]}" ls-remote "$repo_url" "refs/heads/$DEVBOX_BRANCH" 2>/dev/null | awk 'NR==1{print $1}' || true)"
    if [ -n "$image_remote" ] && [ "$image_remote" != "$DEVBOX_COMMIT" ]; then
      echo "dev-box image: new version in the repo (${DEVBOX_COMMIT:0:7} -> ${image_remote:0:7}), just rebuild on the host" >> "$tmp"
    fi
  fi
fi

# --- 3. mise tools (registry metadata only) ---
if command -v mise >/dev/null 2>&1; then
  # --json: stable output (the table has no header outside a terminal);
  # "nothing to do" is {} or an empty output.
  outdated="$(timeout 120 mise outdated --json 2>/dev/null || true)"
  if [ -n "$outdated" ] && [ "$outdated" != "{}" ]; then
    if command -v jq >/dev/null 2>&1; then
      printf '%s' "$outdated" \
        | jq -r 'to_entries[] | select(.value.current != null)
                 | "mise tool: \(.key) \(.value.current) -> \(.value.latest // "?")"' \
        2>/dev/null >> "$tmp" || true
    else
      # Fallback without jq: columns "name requested current latest source"
      timeout 120 mise outdated 2>/dev/null \
        | awk '$1 != "Tool" && NF >= 4 { print "mise tool: " $1 " " $3 " -> " $4 }' \
        >> "$tmp" || true
    fi
  fi
fi

# --- 4. Config shipped by the image (agents, extensions, mise config) ---
if command -v dev-box-seed >/dev/null 2>&1; then
  dev-box-seed --check 2>/dev/null >> "$tmp" || true
fi

# --- 5. Pending migrations ---
# The entrypoint plays them at start, so normally none is left.
# This check covers the case where one failed, or was acknowledged by hand.
if command -v dev-box-migrate >/dev/null 2>&1; then
  pending="$(dev-box-migrate --pending 2>/dev/null | grep -c . || true)"
  if [ "${pending:-0}" -gt 0 ] 2>/dev/null; then
    echo "pending migrations: $pending (devbox migrate)" >> "$tmp"
  fi
fi

mkdir -p "$FLAG_DIR"
if [ -s "$tmp" ]; then
  cp "$tmp" "$FLAG"
else
  rm -f "$FLAG"
fi
