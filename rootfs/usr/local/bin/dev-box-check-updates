#!/usr/bin/env bash
# devbox:name=check
# devbox:summary=Look for updates, install nothing
# devbox:args=[--image]
# Checks, without installing anything, what could be updated: dotfiles (HEAD of
# the clone against the remote branch), the dev-box image, mise tools, config
# shipped by the image. Writes ~/.cache/dev-box/updates (one line per item)
# when something is available, and removes the file otherwise. It only
# downloads metadata and must never block: everything is bounded by a timeout
# and neutralised on failure.
#
#   dev-box-check-updates           check everything, print what is waiting
#   dev-box-check-updates --image   is this image the latest? nothing written
#   dev-box-check-updates --quiet   write the flag, print nothing
#
# The image is compared with the dev-box repository it was built from: the
# published image with the newest v* tag (pulled on the host), a local build with the
# head of its branch (rebuilt on the host). The release notes of the repo are saved on
# the way, in ~/.cache/dev-box/releases.md, for devbox changelog and the login.
set -euo pipefail

# shellcheck source=/dev/null
. /usr/share/devbox/lib/release.sh

# Sets IMAGE_LINE, the line for the flag (empty when nothing is waiting), and
# IMAGE_STATE, the same thing said for a human, up to date or not.
image_check() {
  local own latest tag commit head
  IMAGE_LINE=""; IMAGE_STATE=""
  own="$(devbox_version)"
  if [ "${DEVBOX_COMMIT:-unknown}" = "unknown" ] || [ -z "$DEVBOX_REPO" ]; then
    IMAGE_STATE="unknown: the image does not say what it was built from, rebuild the container on the host"
    return 0
  fi
  if [ "$DEVBOX_SOURCE" = "release" ]; then
    if ! latest="$(devbox_latest_release)"; then
      IMAGE_STATE="$own, could not read the releases of $(devbox_repo_url)"
      return 0
    fi
    tag="${latest%% *}"; commit="${latest#* }"
    if [ "$commit" = "$DEVBOX_COMMIT" ] || ! devbox_version_newer "$tag" "$DEVBOX_VERSION"; then
      IMAGE_STATE="$own, the latest release"
    else
      IMAGE_LINE="dev-box image: $tag released (this box runs $own), pull the image and restart the container on the host"
      IMAGE_STATE="$tag released, this box runs $own: pull the image and restart the container on the host"
    fi
  else
    if ! head="$(devbox_branch_head)"; then
      IMAGE_STATE="$own, could not read $DEVBOX_BRANCH on $(devbox_repo_url)"
      return 0
    fi
    if [ "$head" = "$DEVBOX_COMMIT" ]; then
      IMAGE_STATE="$own, built locally from the head of $DEVBOX_BRANCH"
    else
      IMAGE_LINE="dev-box image: new version in the repo (${DEVBOX_COMMIT:0:7} -> ${head:0:7}), rebuild the container on the host"
      IMAGE_STATE="$DEVBOX_BRANCH is at ${head:0:7}, this box was built from $own: rebuild the container on the host"
    fi
  fi
}

QUIET=0
case "${1:-}" in
  -h|--help) sed -n '5,18p' "$0" | sed 's/^# \?//'; exit 0 ;;
  --image)
    image_check
    printf 'dev-box image: %s\n' "$IMAGE_STATE"
    [ -z "$IMAGE_LINE" ] || echo "What it brings: devbox changelog --upcoming"
    exit 0
    ;;
  --quiet) QUIET=1 ;;
  "") ;;
  *) echo "dev-box-check-updates: unknown option '$1'" >&2; exit 2 ;;
esac

FLAG_DIR="$HOME/.cache/dev-box"
FLAG="$FLAG_DIR/updates"

[ -f /etc/devbox/dotarchy.env ] && . /etc/devbox/dotarchy.env
BRANCH="${DOTARCHY_BRANCH:-main}"
SRC="$HOME/.local/share/dotarchy"

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

image_check
# The notes of the releases, for the login after the next update. A failure
# keeps the previous cache: it is only text to show.
devbox_refresh_releases >/dev/null 2>&1 || true

# --- 1. Dotfiles: local HEAD against remote HEAD (git ls-remote, no object pulled) ---
if [ -d "$SRC/.git" ]; then
  local_head="$(git -C "$SRC" rev-parse HEAD 2>/dev/null || true)"
  remote_head="$(GIT_TERMINAL_PROMPT=0 timeout 30 \
      git -C "$SRC" ls-remote origin "$BRANCH" 2>/dev/null | awk 'NR==1{print $1}' || true)"
  if [ -n "$local_head" ] && [ -n "$remote_head" ] && [ "$local_head" != "$remote_head" ]; then
    echo "dotfiles: new version (${local_head:0:7} -> ${remote_head:0:7})" >> "$tmp"
  fi
fi

# --- 2. dev-box image: against the latest release, or the branch head ---
if [ -n "$IMAGE_LINE" ]; then
  echo "$IMAGE_LINE" >> "$tmp"
fi

# --- 3. mise tools (registry metadata only) ---
if command -v mise >/dev/null 2>&1; then
  # --json: stable output (the table has no header outside a terminal);
  # "nothing to do" is {} or an empty output.
  outdated="$(timeout 120 mise outdated --json 2>/dev/null || true)"
  if [ -n "$outdated" ] && [ "$outdated" != "{}" ]; then
    if command -v jq >/dev/null 2>&1; then
      printf '%s' "$outdated" \
        | jq -r 'to_entries[] | select(.value.current != null)
                 | "mise tool: \(.key) \(.value.current) -> \(.value.latest // "?")"' \
        2>/dev/null >> "$tmp" || true
    else
      # Fallback without jq: columns "name requested current latest source"
      timeout 120 mise outdated 2>/dev/null \
        | awk '$1 != "Tool" && NF >= 4 { print "mise tool: " $1 " " $3 " -> " $4 }' \
        >> "$tmp" || true
    fi
  fi
fi

# --- 4. Config shipped by the image (agents, extensions, mise config) ---
if command -v dev-box-seed >/dev/null 2>&1; then
  dev-box-seed --check 2>/dev/null >> "$tmp" || true
fi

# --- 5. Pending migrations ---
# The entrypoint plays them at start, so normally none is left.
# This check covers the case where one failed, or was acknowledged by hand.
if command -v dev-box-migrate >/dev/null 2>&1; then
  pending="$(dev-box-migrate --pending 2>/dev/null | grep -c . || true)"
  if [ "${pending:-0}" -gt 0 ] 2>/dev/null; then
    echo "pending migrations: $pending (devbox migrate)" >> "$tmp"
  fi
fi

mkdir -p "$FLAG_DIR"
if [ -s "$tmp" ]; then
  cp "$tmp" "$FLAG"
else
  rm -f "$FLAG"
fi

# Said out loud when run by hand. The image line carries its own host command;
# everything else is what devbox update installs.
[ "$QUIET" = 1 ] && exit 0
if [ -s "$FLAG" ]; then
  echo "Waiting:"
  sed 's/^/  /' "$FLAG"
  if grep -qv '^dev-box image:' "$FLAG"; then
    echo "devbox update installs what is in the box."
  fi
else
  echo "Nothing to update."
fi
