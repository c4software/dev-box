
# --- dev-box (secours si USER_SHELL=/bin/bash) ---
. /etc/devbox/tmux-auto.sh
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
command -v mise >/dev/null && eval "$(mise activate bash)"
# Variables du conteneur (écrites par l'entrypoint) : ni Tailscale SSH ni sshd
# n'héritent de l'environnement du PID 1.
[ -r /etc/devbox/env ] && . /etc/devbox/env
