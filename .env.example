# Utilisateur (UID/GID fixés à 1000:1000 dans l'image)
USER_NAME=dev
USER_SHELL=/bin/zsh
TZ=Europe/Paris

# Dossier des projets sur l'hôte (monté en ~/projets, indépendant du home)
PROJECTS_DIR=./data/projets

# Tailscale / Headscale
TS_HOSTNAME=devbox
TS_LOGIN_SERVER=https://headscale.example.com
TS_AUTHKEY=
TS_EXTRA_ARGS=
# Debug : true = pas de Tailscale, accès par `docker exec` uniquement
TS_DISABLE=false

# Dotfiles (repo dotarchy)
DOTARCHY_REPO=https://github.com/c4software/dotarchy.git
DOTARCHY_BRANCH=main
DOTARCHY_SUBDIR=common-no-omarchy
# Resynchronisation automatique en secondes (0 = au démarrage + `dotarchy-sync` à la main)
DOTARCHY_SYNC_INTERVAL=3600

# mise
MISE_INSTALL_ON_START=true
# Recommandé : évite le rate-limit de l'API GitHub (token sans aucun scope)
GITHUB_TOKEN=
