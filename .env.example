# User (UID/GID fixed at 1000:1000 in the image)
USER_NAME=dev
USER_SHELL=/bin/zsh
TZ=Europe/Paris
# Language of the box, for instance fr_FR.UTF-8 or en_US.UTF-8: dates,
# sorting, and for French the devbox menu and the login tips (everything else
# stays in English). C.UTF-8, or empty: English, the image default.
LANG=C.UTF-8

# Projects directory on the host (mounted at ~/projets, separate from the home)
PROJECTS_DIR=./data/projets

# Image to run. Empty: `docker compose up -d --build` builds it locally from
# the Dockerfile. Set to the image published by the GitHub workflow to skip
# the build: `docker compose pull && docker compose up -d`. One image per
# architecture, pick the one of the machine:
#   amd64 (x86_64):                 DEVBOX_IMAGE=ghcr.io/c4software/dev-box:latest
#   arm64 (Raspberry Pi 5, Mac M):  DEVBOX_IMAGE=ghcr.io/c4software/dev-box:latest-arm64
DEVBOX_IMAGE=

# Tailscale / Headscale
TS_HOSTNAME=dev-box
# Control server: Tailscale itself (below), or your own Headscale
# (for instance https://headscale.example.com)
TS_LOGIN_SERVER=https://controlplane.tailscale.com
TS_AUTHKEY=
TS_EXTRA_ARGS=
# true means no Tailscale: the box listens for SSH on the published port
TS_DISABLE=false

# SSH (used only when TS_DISABLE=true), public key only, passwords are off.
# Several keys: one per line, inside the quotes.
SSH_AUTHORIZED_KEYS=
SSH_BIND=127.0.0.1
SSH_PORT=2222

# Dotfiles (the dotarchy repo)
DOTARCHY_REPO=https://github.com/c4software/dotarchy.git
DOTARCHY_BRANCH=main
DOTARCHY_SUBDIR=common-no-omarchy

# Update check (dotfiles, mise tools, shipped config) in seconds.
# It updates nothing: it writes a flag printed at login (0 turns it off).
UPDATE_CHECK_INTERVAL=86400

# Rootless podman inside the box (docker run/build/compose with no host socket).
# It also needs the podman settings of compose.override.example.yaml, which
# loosen the isolation of the container, so it is off by default.
PODMAN_ENABLE=false

# mise: reinstall what is missing at start (without bumping a version)
MISE_INSTALL_ON_START=true
# Dev environments to have in the box, installed at start when missing, in
# the background (devbox dev-env --list for the names). Empty: nothing.
# For instance: DEV_ENVS="node go python"
DEV_ENVS=
# Recommended: avoids the GitHub API rate limit (a token with no scope)
GITHUB_TOKEN=

# LLM proxy used by the llm-proxy.ts extension of pi and omp
LLM_PROXY_URL=http://llmproxy
LLM_PROXY_API_KEY=unused
